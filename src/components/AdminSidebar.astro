---
const pathname = Astro.url.pathname.replace(/\/$/, '');

const links = [
  { path: '/admin/dashboard', name: 'Resumen', icon: 'M4 13h6V4H4v9Zm0 7h6v-4H4v4Zm10 0h6v-9h-6v9Zm0-16v4h6V4h-6Z' },
  { path: '/admin/orders', name: 'Pedidos', icon: 'M6 4h12l1 4H5l1-4Zm-1 4h14v11a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V8Zm5 4h4' },
  { path: '/admin/products', name: 'Productos', icon: 'M20 7 12 3 4 7m16 0-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
  { path: '/admin/categories', name: 'Categorías', icon: 'M4 5h6v6H4V5Zm10 0h6v6h-6V5ZM4 15h6v4H4v-4Zm10 0h6v4h-6v-4Z' },
  { path: '/admin/users', name: 'Usuarios', icon: 'M16 19v-1a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v1m6.5-9a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM21 19v-1a4 4 0 0 0-3-3.9M16 3.1a3.5 3.5 0 0 1 0 6.8' },
];
---

<!-- Escritorio: barra lateral -->
<aside class="sticky top-16 hidden h-[calc(100vh-4rem)] w-64 shrink-0 flex-col bg-ciruela p-4 text-white/70 md:flex">
  <p class="px-3 pb-3 pt-4 font-display text-sm font-semibold text-oro-claro">Administración</p>
  <nav class="space-y-1" aria-label="Administración">
    {
      links.map((link) => {
        const active = pathname === link.path;
        return (
          <a
            href={link.path}
            aria-current={active ? 'page' : undefined}
            class={`flex items-center gap-3 rounded-xl px-3 py-2.5 font-medium transition-colors ${
              active ? 'bg-white/10 text-white' : 'hover:bg-white/5 hover:text-white'
            }`}
          >
            <svg class={`h-5 w-5 ${active ? 'text-oro' : ''}`} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <path d={link.icon} />
            </svg>
            {link.name}
          </a>
        );
      })
    }
  </nav>
  <a href="/" class="mt-auto flex items-center gap-3 rounded-xl px-3 py-2.5 font-medium hover:bg-white/5 hover:text-white">
    <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 19 3 12l7-7M3 12h18"></path></svg>
    Volver a la tienda
  </a>
</aside>

<!-- Celular: barra inferior -->
<nav
  class="fixed inset-x-0 bottom-0 z-50 border-t border-white/10 bg-ciruela pb-[env(safe-area-inset-bottom)] md:hidden"
  aria-label="Administración"
>
  <ul class="grid grid-cols-5">
    {
      links.map((link) => {
        const active = pathname === link.path;
        return (
          <li>
            <a
              href={link.path}
              aria-current={active ? 'page' : undefined}
              class={`relative flex h-16 flex-col items-center justify-center gap-1 text-[10.5px] font-semibold ${
                active ? 'text-white' : 'text-white/55'
              }`}
            >
              {active && <span class="absolute top-0 h-[3px] w-8 rounded-b-full bg-oro" />}
              <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <path d={link.icon} />
              </svg>
              {link.name}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
