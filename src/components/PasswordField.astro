---
interface Props {
  id: string;
  label: string;
  autocomplete: string;
  placeholder?: string;
  minlength?: number;
}
const { id, label, autocomplete, placeholder = '••••••••', minlength } = Astro.props;
---

<div data-password-field>
  <label for={id} class="label">{label}</label>
  <div class="relative">
    <input id={id} type="password" autocomplete={autocomplete} required minlength={minlength} class="field pr-12" placeholder={placeholder} />
    <button
      type="button"
      data-toggle
      aria-label="Mostrar contraseña"
      aria-pressed="false"
      class="absolute right-1.5 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full text-gris hover:text-morado"
    >
      <svg data-eye class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M2.5 12S6 5 12 5s9.5 7 9.5 7-3.5 7-9.5 7-9.5-7-9.5-7Z"></path><circle cx="12" cy="12" r="3"></circle>
      </svg>
      <svg data-eye-off class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path d="M3 3l18 18M10.6 5.1A9.7 9.7 0 0 1 12 5c6 0 9.5 7 9.5 7a17 17 0 0 1-3.2 4.1M6.6 6.6A17 17 0 0 0 2.5 12S6 19 12 19a9.6 9.6 0 0 0 4.4-1.1M9.9 9.9a3 3 0 0 0 4.2 4.2"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-password-field]').forEach((wrap) => {
    const input = wrap.querySelector('input') as HTMLInputElement;
    const btn = wrap.querySelector('[data-toggle]') as HTMLButtonElement;
    btn.addEventListener('click', () => {
      const show = input.type === 'password';
      input.type = show ? 'text' : 'password';
      btn.setAttribute('aria-pressed', String(show));
      btn.setAttribute('aria-label', show ? 'Ocultar contraseña' : 'Mostrar contraseña');
      wrap.querySelector('[data-eye]')?.classList.toggle('hidden', show);
      wrap.querySelector('[data-eye-off]')?.classList.toggle('hidden', !show);
    });
  });
</script>
