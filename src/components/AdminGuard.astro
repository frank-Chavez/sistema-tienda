---
// Muestra "Verificando acceso…" hasta confirmar que el usuario es administrador.
---

<div id="admin-guard" class="fixed inset-0 z-[90] flex items-center justify-center bg-niebla">
  <div class="text-center">
    <div class="mx-auto h-10 w-10 animate-spin rounded-full border-[3px] border-lavanda border-t-morado"></div>
    <p class="mt-4 text-gris">Verificando acceso…</p>
  </div>
</div>
<slot />

<script>
  import { requireAdmin } from '../lib/adminGuard.js';

  requireAdmin().then(() => {
    const guard = document.getElementById('admin-guard');
    if (!guard) return;
    guard.style.transition = 'opacity 200ms ease';
    guard.style.opacity = '0';
    setTimeout(() => guard.remove(), 200);
  });
</script>
