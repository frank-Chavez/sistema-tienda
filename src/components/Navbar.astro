---
import Logo from './Logo.astro';

interface Props {
  admin?: boolean;
}
const { admin = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/products', label: 'Productos' },
];
---

<header class="sticky top-0 z-50 border-b border-borde/70 bg-white/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <Logo />

    <nav class="hidden items-center gap-1 md:flex" aria-label="Principal">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={path === l.href ? 'page' : undefined}
            class="rounded-full px-4 py-2 font-medium text-gris transition-colors hover:text-morado aria-[current=page]:bg-lavanda aria-[current=page]:text-morado"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      {
        admin && (
          <a
            href="/"
            class="btn btn-soft h-10 min-h-10 gap-1.5 px-3.5 text-sm sm:px-4"
            aria-label="Salir del panel y ver la tienda"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5.5h-5V20H5a1 1 0 0 1-1-1v-8.5Z" />
            </svg>
            Ver tienda
          </a>
        )
      }
      <a
        href="/cart"
        class="relative hidden h-11 w-11 items-center justify-center rounded-full text-tinta transition-colors hover:bg-lavanda hover:text-morado md:inline-flex"
        aria-label="Ver carrito"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 7h14l-1.2 11.1a2 2 0 0 1-2 1.9H8.2a2 2 0 0 1-2-1.9L5 7Zm4 0V6a3 3 0 0 1 6 0v1" />
        </svg>
        <span
          data-cart-badge
          hidden
          class="absolute right-0.5 top-0.5 flex h-5 min-w-5 items-center justify-center rounded-full bg-oro px-1 text-[11px] font-bold text-ciruela"
        >0</span>
      </a>

      <!-- Cuenta: se completa con JS -->
      <div id="auth-section" class="relative">
        <a href="/login" class="btn btn-primary h-10 min-h-10 px-4 text-sm">Ingresar</a>
      </div>
    </div>
  </div>
</header>

<script>
  import { authStore } from '../store/auth.js';
  import { cartStore } from '../store/cart.js';
  import { escapeHtml } from '../lib/utils.js';

  function updateCartBadge() {
    const total = cartStore.getTotalItems();
    document.querySelectorAll<HTMLElement>('[data-cart-badge]').forEach((badge) => {
      badge.textContent = total > 99 ? '99+' : String(total);
      badge.hidden = total === 0;
    });
  }

  function updateAuthUI() {
    const section = document.getElementById('auth-section');
    if (!section) return;

    if (!authStore.isLoggedIn()) {
      section.innerHTML = `
        <a href="/login" class="btn btn-primary h-10 min-h-10 px-4 text-sm">Ingresar</a>`;
      return;
    }

    const user = authStore.user;
    const nombre = escapeHtml(user?.nombre || 'Mi cuenta');
    const inicial = escapeHtml((user?.nombre || '?').trim().charAt(0).toUpperCase());
    const primerNombre = escapeHtml((user?.nombre || '').split(' ')[0]);

    section.innerHTML = `
      <button id="account-btn" type="button" aria-haspopup="menu" aria-expanded="false"
        class="flex h-11 items-center gap-2 rounded-full pl-1 pr-1 transition-colors hover:bg-lavanda sm:pr-3">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-ciruela font-display text-sm font-bold text-oro-claro">${inicial}</span>
        <span class="hidden text-sm font-semibold text-tinta sm:block">${primerNombre}</span>
      </button>
      <div id="account-menu" role="menu" hidden
        class="absolute right-0 top-full mt-2 w-60 overflow-hidden rounded-2xl border border-borde bg-white p-2 shadow-[0_18px_40px_-16px_rgba(42,14,79,0.35)]">
        <div class="px-3 py-2">
          <p class="truncate text-sm font-semibold text-tinta">${nombre}</p>
          <p class="truncate text-xs text-gris">${escapeHtml(user?.email || '')}</p>
        </div>
        ${
          location.pathname.startsWith('/admin')
            ? `<a role="menuitem" href="/" class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-sm font-semibold text-morado hover:bg-lavanda">Ver la tienda</a>`
            : authStore.isAdmin()
              ? `<a role="menuitem" href="/admin/dashboard" class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-sm font-semibold text-morado hover:bg-lavanda">Panel de administración</a>`
              : ''
        }
        <a role="menuitem" href="/cart" class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-sm font-medium text-tinta hover:bg-lavanda">Mi carrito</a>
        <button role="menuitem" id="logout-btn" type="button" class="flex w-full items-center gap-2 rounded-xl px-3 py-2.5 text-left text-sm font-medium text-[#b42318] hover:bg-[#fdecea]">Cerrar sesión</button>
      </div>`;

    document.getElementById('account-btn')?.addEventListener('click', (e) => {
      e.stopPropagation();
      setMenuOpen(!!document.getElementById('account-menu')?.hidden);
    });

    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await authStore.logout();
      window.location.href = '/';
    });
  }

  function setMenuOpen(open: boolean) {
    const menu = document.getElementById('account-menu');
    const btn = document.getElementById('account-btn');
    if (!menu || !btn) return;
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
  }
  document.addEventListener('click', (e) => {
    const menu = document.getElementById('account-menu');
    if (menu && !menu.contains(e.target as Node)) setMenuOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenuOpen(false);
  });

  updateCartBadge();
  updateAuthUI();
  window.addEventListener('cart_change', updateCartBadge);
  window.addEventListener('auth_change', updateAuthUI);
  // Si Firebase dice que la sesión ya no existe, se actualiza el menú.
  authStore.ready.then(updateAuthUI);
</script>
