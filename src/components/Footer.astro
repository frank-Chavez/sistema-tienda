---
import Logo from './Logo.astro';
const currentYear = new Date().getFullYear();
---

<footer class="mt-24 bg-ciruela text-white/75">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div class="max-w-sm">
        <Logo light />
        <p class="mt-4 leading-relaxed">
          Productos naturales para el cuidado de tu salud y la de tu familia. Haz tu pedido y lo
          coordinamos contigo por WhatsApp.
        </p>
      </div>

      <div>
        <h2 class="font-display text-lg font-semibold text-oro-claro">Tienda</h2>
        <ul class="mt-4 space-y-3">
          <li><a href="/products" class="hover:text-white">Todos los productos</a></li>
          <li><a href="/cart" class="hover:text-white">Mi carrito</a></li>
          <li><a href="/login" class="hover:text-white">Mi cuenta</a></li>
        </ul>
      </div>

      <div>
        <h2 class="font-display text-lg font-semibold text-oro-claro">Contacto</h2>
        <ul class="mt-4 space-y-3">
          <li>
            <a
              href="https://wa.me/51975279174?text=Hola%2C%20quisiera%20informaci%C3%B3n%20sobre%20sus%20productos."
              target="_blank"
              rel="noopener"
              class="hover:text-white">WhatsApp +51 975 279 174</a
            >
          </li>
          <li>
            <a href="mailto:elsachavez9752@gmail.com" class="break-all hover:text-white">elsachavez9752@gmail.com</a>
          </li>
          <li>
            <a href="https://maps.app.goo.gl/jg9hAq7sdR2ggMjYA" target="_blank" rel="noopener" class="hover:text-white"
              >Santa Rosa, Señor de los Milagros (ver en mapa)</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-white/10 pt-6 text-sm text-white/50">
      &copy; {currentYear} E.F.D. Tienda Naturista
    </div>
  </div>
</footer>
