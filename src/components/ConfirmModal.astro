---
// Ventana de confirmación. Se usa con:
//   const ok = await window.showConfirm('Título', 'Mensaje', 'Sí, eliminar');
---

<div id="confirm-modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="confirm-modal-title">
  <div class="modal-sheet p-6 sm:p-8">
    <div class="mx-auto mb-5 h-1.5 w-10 rounded-full bg-borde sm:hidden"></div>
    <h3 id="confirm-modal-title" class="text-2xl font-bold text-tinta">¿Estás seguro?</h3>
    <p id="confirm-modal-message" class="mt-2 text-gris">Esta acción no se puede deshacer.</p>
    <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
      <button id="confirm-modal-cancel" type="button" class="btn btn-outline">Cancelar</button>
      <button id="confirm-modal-confirm" type="button" class="btn bg-[#b42318] text-white hover:bg-[#8f1c13]">
        Sí, eliminar
      </button>
    </div>
  </div>
</div>

<script>
  import { openModal, closeModal, wireModal } from '../lib/modal.js';

  const modal = document.getElementById('confirm-modal');
  const titleEl = document.getElementById('confirm-modal-title');
  const msgEl = document.getElementById('confirm-modal-message');
  const cancelBtn = document.getElementById('confirm-modal-cancel');
  const confirmBtn = document.getElementById('confirm-modal-confirm');

  let currentResolve: ((value: boolean) => void) | null = null;

  const finish = (value: boolean) => {
    closeModal(modal);
    currentResolve?.(value);
    currentResolve = null;
  };

  (window as any).showConfirm = (
    title: string,
    message: string,
    confirmText = 'Sí, eliminar',
    cancelText = 'Cancelar',
  ) =>
    new Promise<boolean>((resolve) => {
      if (!modal) return resolve(false);
      if (titleEl) titleEl.textContent = title;
      if (msgEl) msgEl.textContent = message;
      if (confirmBtn) confirmBtn.textContent = confirmText;
      if (cancelBtn) cancelBtn.textContent = cancelText;
      currentResolve = resolve;
      openModal(modal);
    });

  wireModal(modal, () => finish(false));
  cancelBtn?.addEventListener('click', () => finish(false));
  confirmBtn?.addEventListener('click', () => finish(true));
</script>
