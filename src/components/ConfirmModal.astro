---
interface Props {
  id?: string;
}

const { id = 'confirm-modal' } = Astro.props;
---

<div
  id={id}
  class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm z-100 hidden items-center justify-center p-4 opacity-0 transition-opacity duration-300"
>
  <div
    class="bg-white rounded-3xl shadow-2xl w-full max-w-md transform scale-95 transition-transform duration-300 overflow-hidden"
    id={`${id}-content`}
  >
    <div class="p-8 text-center">
      <div
        class="w-20 h-20 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-6"
      >
        <svg
          class="w-10 h-10"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
          ></path>
        </svg>
      </div>

      <h3 class="text-2xl font-black text-gray-900 mb-2" id={`${id}-title`}>
        ¿Estás seguro?
      </h3>
      <p class="text-gray-500 mb-8" id={`${id}-message`}>
        Esta acción no se puede deshacer de ninguna manera.
      </p>

      <div class="flex gap-3 mt-8">
        <button
          id={`${id}-cancel`}
          class="flex-1 px-6 py-3 rounded-xl font-bold text-gray-700 bg-gray-100 hover:bg-gray-200 transition-colors"
        >
          Cancelar
        </button>
        <button
          id={`${id}-confirm`}
          class="flex-1 px-6 py-3 rounded-xl font-bold text-white bg-red-600 hover:bg-red-700 shadow-lg shadow-red-200 transition-all active:scale-95"
        >
          Sí, eliminar
        </button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ id }}>
  const modal = document.getElementById(id);
  const content = document.getElementById(`${id}-content`);
  const cancelBtn = document.getElementById(`${id}-cancel`);
  const confirmBtn = document.getElementById(`${id}-confirm`);

  let currentResolve = null;

  window.showConfirm = (
    title,
    message,
    confirmText = 'Sí, eliminar',
    cancelText = 'Cancelar',
  ) => {
    return new Promise((resolve) => {
      if (!modal || !content) return resolve(false);

      // Update text
      const titleEl = document.getElementById(`${id}-title`);
      const msgEl = document.getElementById(`${id}-message`);
      const confirmBtnEl = document.getElementById(`${id}-confirm`);
      const cancelBtnEl = document.getElementById(`${id}-cancel`);

      if (titleEl && title) titleEl.textContent = title;
      if (msgEl && message) msgEl.textContent = message;
      if (confirmBtnEl && confirmText) confirmBtnEl.textContent = confirmText;

      if (cancelBtnEl) {
        if (!cancelText) {
          cancelBtnEl.classList.add('hidden');
        } else {
          cancelBtnEl.classList.remove('hidden');
          cancelBtnEl.textContent = cancelText;
        }
      }

      currentResolve = resolve;

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        content.classList.remove('scale-95');
      }, 10);
    });
  };

  const close = (value) => {
    if (!modal || !content) return;
    modal.classList.add('opacity-0');
    content.classList.add('scale-95');
    setTimeout(() => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      if (currentResolve) currentResolve(value);
      currentResolve = null;
    }, 300);
  };

  cancelBtn?.addEventListener('click', () => close(false));
  confirmBtn?.addEventListener('click', () => close(true));
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) close(false);
  });
</script>
