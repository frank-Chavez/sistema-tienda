---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada">
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <h1 class="text-4xl font-bold sm:text-5xl">No encontramos esta página</h1>
    <p class="mt-4 text-gris">Puede que el enlace esté mal escrito o que la página ya no exista.</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/products" class="btn btn-primary">Ver productos</a>
      <a href="/" class="btn btn-outline">Ir al inicio</a>
    </div>
  </div>
</Layout>
