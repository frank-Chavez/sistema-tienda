---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tu carrito" description="Revisa tu pedido y envíalo por WhatsApp.">
  <div class="mx-auto max-w-6xl px-4 pt-8 sm:px-6 md:pt-12 lg:px-8">
    <h1 class="text-4xl font-bold sm:text-5xl">Tu carrito</h1>
    <p id="cart-count" class="mt-2 text-gris">&nbsp;</p>

    <div id="cart-empty" hidden class="panel mt-8 px-6 py-14 text-center">
      <p class="font-display text-2xl font-semibold">Tu carrito está vacío</p>
      <p class="mx-auto mt-2 max-w-sm text-gris">Agrega productos desde el catálogo y aquí verás tu pedido.</p>
      <a href="/products" class="btn btn-primary mt-6">Ver productos</a>
    </div>

    <div id="cart-content" hidden class="mt-8 grid gap-8 lg:grid-cols-[1fr_22rem] lg:items-start">
      <ul id="cart-items" class="panel divide-y divide-borde"></ul>

      <aside class="panel p-6 lg:sticky lg:top-24">
        <h2 class="text-xl font-bold">Resumen</h2>
        <dl class="mt-4 space-y-2 text-gris">
          <div class="flex justify-between"><dt>Productos</dt><dd id="summary-items">0</dd></div>
          <div class="flex justify-between"><dt>Envío</dt><dd>Se coordina por WhatsApp</dd></div>
        </dl>
        <div class="mt-4 flex items-end justify-between border-t border-borde pt-4">
          <span class="font-semibold">Total</span>
          <span id="summary-total" class="font-display text-3xl font-bold text-morado">S/ 0.00</span>
        </div>

        <form id="order-form" class="mt-6 space-y-4">
          <div>
            <label for="telefono" class="label">Tu celular <span class="font-normal text-gris">(opcional)</span></label>
            <input id="telefono" type="tel" inputmode="tel" autocomplete="tel" class="field" placeholder="999 999 999" />
          </div>
          <div>
            <label for="direccion" class="label">Dirección o referencia <span class="font-normal text-gris">(opcional)</span></label>
            <textarea id="direccion" rows="2" class="field resize-none" placeholder="Ej. Jr. Los Pinos 123, frente al parque"></textarea>
          </div>
          <button id="whatsapp-btn" type="submit" class="btn btn-whatsapp h-13 w-full text-base">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.82 11.82 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.347-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.876 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"></path></svg>
            <span data-label>Enviar pedido por WhatsApp</span>
          </button>
          <p id="login-hint" hidden class="text-center text-sm text-gris">
            Necesitas iniciar sesión para enviar tu pedido.
          </p>
        </form>
      </aside>
    </div>
  </div>
</Layout>

<script>
  import { cartStore } from '../store/cart.js';
  import { authStore } from '../store/auth.js';
  import { createOrder } from '../lib/firebaseOrders.js';
  import { showToast } from '../lib/toast.js';
  import { escapeHtml, formatPrice, STORE_PHONE } from '../lib/utils.js';

  const list = document.getElementById('cart-items') as HTMLElement;
  const empty = document.getElementById('cart-empty') as HTMLElement;
  const content = document.getElementById('cart-content') as HTMLElement;
  const form = document.getElementById('order-form') as HTMLFormElement;
  const submitBtn = document.getElementById('whatsapp-btn') as HTMLButtonElement;

  function renderCart() {
    const items = cartStore.items;
    const totalItems = cartStore.getTotalItems();

    (document.getElementById('cart-count') as HTMLElement).textContent =
      totalItems === 0 ? '' : totalItems === 1 ? '1 producto' : `${totalItems} productos`;

    empty.hidden = items.length > 0;
    content.hidden = items.length === 0;
    (document.getElementById('login-hint') as HTMLElement).hidden = authStore.isLoggedIn();
    if (!items.length) return;

    list.innerHTML = items
      .map(
        (item: any) => `
      <li class="flex gap-4 p-4 sm:p-5" data-id="${escapeHtml(item.id)}">
        <div class="h-20 w-20 shrink-0 overflow-hidden rounded-2xl bg-lavanda sm:h-24 sm:w-24">
          <img src="${escapeHtml(item.image)}" alt="" class="h-full w-full object-contain p-1.5 mix-blend-multiply" />
        </div>
        <div class="flex min-w-0 grow flex-col">
          <div class="flex items-start justify-between gap-3">
            <p class="line-clamp-2 font-semibold leading-snug">${escapeHtml(item.name)}</p>
            <button type="button" data-action="remove" aria-label="Quitar ${escapeHtml(item.name)}"
              class="-mr-2 -mt-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-gris hover:bg-[#fdecea] hover:text-[#b42318]">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 7h14M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/></svg>
            </button>
          </div>
          <p class="text-sm text-gris">${formatPrice(item.price)} c/u</p>
          <div class="mt-auto flex items-center justify-between pt-2">
            <div class="flex items-center rounded-full border border-borde">
              <button type="button" data-action="dec" aria-label="Quitar una unidad" class="flex h-9 w-9 items-center justify-center rounded-full text-lg hover:bg-lavanda">−</button>
              <span class="w-8 text-center font-semibold" aria-live="polite">${item.quantity}</span>
              <button type="button" data-action="inc" aria-label="Agregar una unidad" class="flex h-9 w-9 items-center justify-center rounded-full text-lg hover:bg-lavanda" ${item.quantity >= item.stock ? 'disabled' : ''}>+</button>
            </div>
            <p class="font-display text-lg font-bold">${formatPrice(item.price * item.quantity)}</p>
          </div>
        </div>
      </li>`,
      )
      .join('');

    (document.getElementById('summary-items') as HTMLElement).textContent = String(totalItems);
    (document.getElementById('summary-total') as HTMLElement).textContent = formatPrice(cartStore.getTotal());
  }

  list.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-action]');
    const row = btn?.closest<HTMLElement>('[data-id]');
    if (!btn || !row) return;
    const item = cartStore.items.find((i: any) => i.id === row.dataset.id);
    if (!item) return;
    if (btn.dataset.action === 'inc') cartStore.updateQuantity(item.id, item.quantity + 1);
    if (btn.dataset.action === 'dec') cartStore.updateQuantity(item.id, item.quantity - 1);
    if (btn.dataset.action === 'remove') cartStore.removeItem(item.id);
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const items = cartStore.items;
    if (!items.length) return;

    const user = authStore.user;
    if (!user) {
      window.location.href = '/login?redirect=/cart';
      return;
    }

    const telefono = (document.getElementById('telefono') as HTMLInputElement).value.trim();
    const direccion = (document.getElementById('direccion') as HTMLTextAreaElement).value.trim();
    const nombre = user.nombre || 'Cliente';
    const total = cartStore.getTotal();

    let text = `¡Hola E.F.D.! Soy ${nombre}. Quiero hacer este pedido:\n\n`;
    items.forEach((item: any) => {
      text += `• ${item.quantity} x ${item.name} — ${formatPrice(item.price * item.quantity)}\n`;
    });
    text += `\n*Total: ${formatPrice(total)}*`;
    if (telefono) text += `\nCelular: ${telefono}`;
    if (direccion) text += `\nEntrega: ${direccion}`;
    text += `\n\n¿Me confirman el pago y la entrega? Gracias.`;
    const waUrl = `https://wa.me/${STORE_PHONE}?text=${encodeURIComponent(text)}`;

    // La ventana se abre ANTES de esperar a Firebase: si se abre después,
    // los navegadores de celular la bloquean y WhatsApp nunca aparecía.
    const waWindow = window.open('', '_blank');

    submitBtn.disabled = true;
    const label = submitBtn.querySelector('[data-label]') as HTMLElement;
    label.textContent = 'Enviando pedido…';

    const result = await createOrder({
      usuarioId: user.id,
      nombre,
      email: user.email || '',
      telefono,
      direccion,
      productos: items.map((item: any) => ({
        id: item.id,
        nombre: item.name,
        precio: item.price,
        cantidad: item.quantity,
      })),
      total,
    });

    submitBtn.disabled = false;
    label.textContent = 'Enviar pedido por WhatsApp';

    if (!result.success) {
      waWindow?.close();
      showToast('No se pudo guardar el pedido. Revisa tu conexión e intenta de nuevo.', 'error');
      return;
    }

    cartStore.clearCart();
    if (waWindow) waWindow.location.href = waUrl;
    else window.location.href = waUrl;
    showToast('Pedido guardado. Termina de enviarlo en WhatsApp.', 'success', 5000);
  });

  renderCart();
  window.addEventListener('cart_change', renderCart);
  window.addEventListener('auth_change', renderCart);
</script>
