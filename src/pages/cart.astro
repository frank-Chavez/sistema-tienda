---
import Layout from '../layouts/Layout.astro';
import CartItemTemplate from '../components/CartItem.astro'; // Using the slot trick to import a template
import { cartStore } from '../store/cart.js';
import { authStore } from '../store/auth.js';
import { showToast } from '../lib/toast.js';
---

<Layout title="Tu Carrito" description="Revisa los productos en tu carrito.">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 min-h-[60vh]">
    <h1
      class="text-3xl font-black text-gray-900 mb-8 tracking-tight flex items-center gap-3"
    >
      Tu Carrito
      <span
        id="header-items-count"
        class="bg-purple-100 text-purple-700 text-lg py-1 px-3 rounded-xl font-bold border border-purple-200"
        >0</span
      >
    </h1>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      <!-- Cart Items Section -->
      <div class="lg:col-span-8">
        <div
          id="cart-empty"
          class="hidden text-center py-20 bg-white rounded-3xl border border-gray-100 shadow-sm"
        >
          <div
            class="w-24 h-24 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-6"
          >
            <svg
              class="w-12 h-12 text-gray-300"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
              ></path></svg
            >
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">
            Tu carrito está vacío
          </h3>
          <p class="text-gray-500 mb-8 max-w-sm mx-auto">
            Parece que aún no has añadido nada. Explora nuestros productos y
            encuentra lo que necesitas.
          </p>
          <a
            href="/products"
            class="inline-flex items-center gap-2 bg-purple-600 text-white font-bold py-3 px-8 rounded-xl hover:bg-purple-700 transition-colors shadow-lg shadow-purple-200"
          >
            Ir a Productos
          </a>
        </div>

        <div id="cart-items-container" class="space-y-4">
          <!-- Populated by JS -->
        </div>
      </div>

      <!-- Summary Section -->
      <div id="cart-summary" class="lg:col-span-4 hidden">
        <div
          class="bg-white rounded-3xl border border-gray-100 p-8 shadow-lg shadow-gray-100/50 sticky top-24"
        >
          <h2
            class="text-xl font-bold text-gray-900 mb-6 pb-4 border-b border-gray-100"
          >
            Resumen del Pedido
          </h2>

          <div class="space-y-4 mb-6">
            <div
              class="flex justify-between items-center text-gray-600 font-medium"
            >
              <span>Subtotal</span>
              <span id="summary-subtotal">S/ 0.00</span>
            </div>
            <div
              class="flex justify-between items-center text-gray-600 font-medium pb-4 border-b border-gray-100"
            >
              <span>Envío</span>
              <span
                class="text-green-600 font-bold bg-green-50 px-2 py-0.5 rounded text-sm"
                >Gratis</span
              >
            </div>
            <div class="flex justify-between items-end">
              <span class="text-lg font-bold text-gray-900">Total</span>
              <span
                id="summary-total"
                class="text-3xl font-black text-purple-700 tracking-tight"
                >S/ 0.00</span
              >
            </div>
          </div>

          <button
            id="whatsapp-btn"
            class="w-full bg-[#25D366] hover:bg-[#128C7E] text-white font-bold py-4 px-4 rounded-xl transition-all duration-300 flex items-center justify-center gap-3 hover:shadow-lg hover:shadow-green-200 active:scale-[0.98] mb-4"
          >
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.245 3.483 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.347-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.876 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
              ></path></svg
            >
            Pedir por WhatsApp
          </button>

          <p
            class="text-xs text-gray-400 text-center flex flex-col items-center gap-2"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
              ></path></svg
            >
            Tus datos están seguros y protegidos.
          </p>
        </div>
      </div>
    </div>
  </div>

  <CartItemTemplate />
</Layout>

<script type="module">
  import { cartStore } from '/store/cart.js';
  import { authStore } from '/store/auth.js';

  // Toast function inlined to avoid import issues in static builds
  function showToast(message, type = 'info', duration = 3200) {
    if (typeof window === 'undefined') return;

    let container = document.getElementById('global-toast-container');

    if (!container) {
      container = document.createElement('div');
      container.id = 'global-toast-container';
      container.style.position = 'fixed';
      container.style.top = '1rem';
      container.style.right = '1rem';
      container.style.zIndex = 9999;
      container.style.display = 'flex';
      container.style.flexDirection = 'column';
      container.style.gap = '0.5rem';
      document.body.appendChild(container);
    }

    const toast = document.createElement('div');
    toast.style.minWidth = '240px';
    toast.style.padding = '12px 14px';
    toast.style.borderRadius = '10px';
    toast.style.color = '#ffffff';
    toast.style.boxShadow = '0 8px 22px rgba(0, 0, 0, 0.16)';
    toast.style.fontSize = '0.9rem';
    toast.style.fontWeight = '600';
    toast.style.opacity = '0';
    toast.style.transform = 'translateX(20px)';
    toast.style.transition = 'opacity 220ms ease, transform 220ms ease';

    let backgroundColor = '#06b6d4';
    if (type === 'success') backgroundColor = '#10b981';
    if (type === 'warning') backgroundColor = '#f59e0b';
    if (type === 'error') backgroundColor = '#ef4444';

    toast.style.backgroundColor = backgroundColor;
    toast.textContent = message;

    container.appendChild(toast);

    requestAnimationFrame(() => {
      toast.style.opacity = '1';
      toast.style.transform = 'translateX(0)';
    });

    const hide = () => {
      toast.style.opacity = '0';
      toast.style.transform = 'translateX(20px)';
      setTimeout(() => {
        if (toast.parentElement) toast.parentElement.removeChild(toast);
      }, 220);
    };

    setTimeout(hide, duration);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('cart-items-container');
    const template = document.getElementById('cart-item-template');
    const emptyState = document.getElementById('cart-empty');
    const summary = document.getElementById('cart-summary');

    function renderCart() {
      const items = cartStore.items;

      const countEl = document.getElementById('header-items-count');
      if (countEl) countEl.textContent = cartStore.getTotalItems().toString();

      if (!container || !emptyState || !summary || !template) return;

      if (items.length === 0) {
        container.innerHTML = '';
        emptyState.classList.remove('hidden');
        summary.classList.add('hidden');
        return;
      }

      emptyState.classList.add('hidden');
      summary.classList.remove('hidden');
      container.innerHTML = '';

      items.forEach((item) => {
        const clone = template.content.cloneNode(true);

        const img = clone.querySelector('.item-image');
        if (img) img.src = item.image;
        const nameNode = clone.querySelector('.item-name');
        if (nameNode) nameNode.textContent = item.name;
        const priceNode = clone.querySelector('.item-price');
        if (priceNode)
          priceNode.textContent = `S/ ${parseFloat(item.price).toFixed(2)}`;
        const qNode = clone.querySelector('.item-quantity');
        if (qNode) qNode.textContent = item.quantity;
        const subNode = clone.querySelector('.item-subtotal');
        if (subNode)
          subNode.textContent = `S/ ${(item.price * item.quantity).toFixed(2)}`;

        // Add event listeners
        clone.querySelector('.btn-increase')?.addEventListener('click', () => {
          cartStore.updateQuantity(item.id, item.quantity + 1);
        });

        clone.querySelector('.btn-decrease')?.addEventListener('click', () => {
          cartStore.updateQuantity(item.id, item.quantity - 1);
        });

        clone.querySelector('.btn-remove')?.addEventListener('click', () => {
          cartStore.removeItem(item.id);
        });

        container.appendChild(clone);
      });

      // Update summary
      const total = cartStore.getTotal().toFixed(2);
      const subTotalEl = document.getElementById('summary-subtotal');
      if (subTotalEl) subTotalEl.textContent = `S/ ${total}`;
      const totalEl = document.getElementById('summary-total');
      if (totalEl) totalEl.textContent = `S/ ${total}`;
    }

    // Setup WhatsApp Action
    document
      .getElementById('whatsapp-btn')
      ?.addEventListener('click', async () => {
        const items = cartStore.items;

        if (items.length === 0) return;

        const user = authStore.user;

        let nombreCliente = '';
        if (user) {
          nombreCliente = user.nombre || 'Cliente';
        } else {
          nombreCliente = prompt('Ingresa tu nombre para el pedido:') || '';
          if (!nombreCliente) return;
        }

        const userName = nombreCliente;

        let text = `¡Hola NaturaBio! Soy ${userName}. Me gustaría realizar el siguiente pedido:\n\n`;

        items.forEach((item) => {
          text += `- ${item.quantity}x ${item.name} (S/ ${(item.price * item.quantity).toFixed(2)})\n`;
        });

        text += `\n*TOTAL: S/ ${cartStore.getTotal().toFixed(2)}*`;
        text += `\n\nPor favor, confirmarme los datos para el pago y envío. ¡Gracias!`;

        const phone = '51975279174';
        const encodedText = encodeURIComponent(text);

        // ✅ CREAR PEDIDO EN FIRESTORE
        // @ts-ignore
        const { createOrder } = await import('../lib/firebaseOrders.js');

        const orderData = {
          usuarioId: user ? user.id : 'invitado',
          nombre: nombreCliente,
          telefono: '', // Se puede agregar después
          productos: items.map((item) => ({
            id: item.id,
            nombre: item.name,
            precio: item.price,
            cantidad: item.quantity,
          })),
          total: cartStore.getTotal(),
        };

        const result = await createOrder(orderData);

        if (result.success) {
          // Limpiar carrito después de crear pedido
          cartStore.clearCart();
          // WhatsApp
          window.open(`https://wa.me/${phone}?text=${encodedText}`, '_blank');
        } else {
          showToast('Error al crear pedido. Intenta de nuevo.', 'error');
        }
      });

    renderCart();
    window.addEventListener('cart_change', renderCart);
  });
</script>
