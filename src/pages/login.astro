---
import Layout from '../layouts/Layout.astro';
import AuthShell from '../components/AuthShell.astro';
import PasswordField from '../components/PasswordField.astro';
---

<Layout title="Iniciar sesión" description="Ingresa a tu cuenta de E.F.D.">
  <AuthShell heading="Iniciar sesión">
    <p class="mt-2 text-gris">
      ¿Primera vez aquí? <a href="/register" data-keep-redirect class="font-semibold text-morado hover:underline">Crea tu cuenta</a>
    </p>

    <div id="form-message" hidden role="alert" class="mt-6 rounded-2xl px-4 py-3 text-sm font-medium"></div>

    <form id="login-form" class="mt-6 space-y-5" novalidate>
      <div>
        <label for="email" class="label">Correo electrónico</label>
        <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required class="field" placeholder="tu@correo.com" />
      </div>
      <PasswordField id="password" label="Contraseña" autocomplete="current-password" />

      <div class="flex items-center justify-between gap-4">
        <label class="flex cursor-pointer items-center gap-2 text-sm">
          <input id="remember" type="checkbox" checked class="h-4 w-4 accent-[#5b21b6]" />
          Mantener sesión iniciada
        </label>
        <button id="forgot-btn" type="button" class="text-sm font-semibold text-morado hover:underline">
          Olvidé mi contraseña
        </button>
      </div>

      <button id="submit-btn" type="submit" class="btn btn-primary h-12 w-full text-base">Iniciar sesión</button>
    </form>

    <div class="my-6 flex items-center gap-3 text-sm text-gris">
      <span class="h-px grow bg-borde"></span>o<span class="h-px grow bg-borde"></span>
    </div>

    <button id="google-btn" type="button" class="btn btn-outline h-12 w-full text-base">
      <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z" fill="#34A853"></path><path d="M5.84 14.09A6.6 6.6 0 0 1 5.49 12c0-.73.13-1.43.35-2.09V7.07H2.18A11 11 0 0 0 1 12c0 1.78.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"></path><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1A11 11 0 0 0 2.18 7.07l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z" fill="#EA4335"></path></svg>
      Continuar con Google
    </button>
  </AuthShell>
</Layout>

<script>
  import { authStore } from '../store/auth.js';
  import { safeRedirect } from '../lib/utils.js';

  const params = new URLSearchParams(location.search);
  const redirectParam = params.get('redirect');
  const destination = () =>
    safeRedirect(redirectParam, authStore.isAdmin() ? '/admin/dashboard' : '/');

  // Lleva el ?redirect= también al enlace de registro.
  if (redirectParam) {
    document.querySelectorAll<HTMLAnchorElement>('[data-keep-redirect]').forEach((a) => {
      a.href += `?redirect=${encodeURIComponent(safeRedirect(redirectParam))}`;
    });
  }

  // Si ya hay sesión real (confirmada por Firebase), no tiene sentido estar aquí.
  authStore.ready.then(() => {
    if (authStore.isLoggedIn()) location.replace(destination());
  });
  window.addEventListener('auth_change', () => {
    if (authStore.isLoggedIn()) location.replace(destination());
  });

  const form = document.getElementById('login-form') as HTMLFormElement;
  const email = document.getElementById('email') as HTMLInputElement;
  const password = document.getElementById('password') as HTMLInputElement;
  const remember = document.getElementById('remember') as HTMLInputElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const googleBtn = document.getElementById('google-btn') as HTMLButtonElement;
  const msg = document.getElementById('form-message') as HTMLElement;

  function showMessage(text: string, kind: 'error' | 'success' = 'error') {
    msg.textContent = text;
    msg.className =
      'mt-6 rounded-2xl px-4 py-3 text-sm font-medium ' +
      (kind === 'error' ? 'bg-[#fdecea] text-[#b42318]' : 'bg-[#e3f3e8] text-hoja');
    msg.hidden = false;
  }

  function setBusy(busy: boolean) {
    submitBtn.disabled = busy;
    googleBtn.disabled = busy;
    submitBtn.textContent = busy ? 'Ingresando…' : 'Iniciar sesión';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    msg.hidden = true;

    if (!email.value.trim() || !password.value) {
      showMessage('Escribe tu correo y tu contraseña.');
      return;
    }

    setBusy(true);
    const result = await authStore.login(email.value.trim(), password.value, remember.checked);
    if (result.success) {
      location.href = destination();
    } else {
      setBusy(false);
      showMessage(result.message);
      password.select();
    }
  });

  googleBtn.addEventListener('click', async () => {
    msg.hidden = true;
    setBusy(true);
    const result = await authStore.loginWithGoogle();
    if (result.redirecting) return;
    if (result.success) {
      location.href = destination();
    } else {
      setBusy(false);
      showMessage(result.message);
    }
  });

  document.getElementById('forgot-btn')?.addEventListener('click', async () => {
    const value = email.value.trim();
    if (!value) {
      showMessage('Escribe tu correo arriba y vuelve a tocar "Olvidé mi contraseña".');
      email.focus();
      return;
    }
    const result = await authStore.resetPassword(value);
    if (result.success) {
      showMessage(`Te enviamos un enlace a ${value} para crear una nueva contraseña.`, 'success');
    } else {
      showMessage(result.message);
    }
  });
</script>
