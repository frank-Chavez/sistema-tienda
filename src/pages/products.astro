---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Productos" description="Catálogo de productos naturales de E.F.D.">
  <div class="mx-auto max-w-7xl px-4 pt-8 sm:px-6 md:pt-12 lg:px-8">
    <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div>
        <h1 class="text-4xl font-bold sm:text-5xl">Productos</h1>
        <p id="results-count" class="mt-2 text-gris" aria-live="polite">Cargando catálogo…</p>
      </div>
      <label class="relative block w-full md:w-80">
        <span class="sr-only">Buscar producto</span>
        <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-gris" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <input id="search" type="search" class="field rounded-full pl-11" placeholder="Buscar por nombre" autocomplete="off" />
      </label>
    </div>

    <!-- Categorías: se desplazan de lado en celular -->
    <div class="sticky top-16 z-30 -mx-4 mt-6 bg-niebla/95 px-4 py-3 backdrop-blur-sm sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8">
      <div id="category-chips" class="no-scrollbar flex gap-2 overflow-x-auto" role="group" aria-label="Filtrar por categoría">
        <button type="button" class="chip" aria-pressed="true" data-cat="Todos">Todos</button>
      </div>
    </div>

    <div id="products-grid" class="mt-4 grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-x-6 md:grid-cols-3 lg:grid-cols-4"></div>

    <div id="empty-state" hidden class="panel mt-6 p-10 text-center">
      <p class="font-display text-xl font-semibold">No encontramos productos</p>
      <p class="mt-2 text-gris">Prueba con otra palabra o elige otra categoría.</p>
      <button id="clear-filters" type="button" class="btn btn-soft mt-5">Ver todos los productos</button>
    </div>
  </div>
</Layout>

<script>
  import { productsStore } from '../store/products.js';
  import { setGridProducts, skeletonCards } from '../lib/productCard.js';
  import { escapeHtml } from '../lib/utils.js';

  const grid = document.getElementById('products-grid') as HTMLElement;
  const chips = document.getElementById('category-chips') as HTMLElement;
  const search = document.getElementById('search') as HTMLInputElement;
  const empty = document.getElementById('empty-state') as HTMLElement;
  const count = document.getElementById('results-count') as HTMLElement;

  let selected = new URLSearchParams(location.search).get('categoria') || 'Todos';
  let products: any[] = [];

  grid.innerHTML = skeletonCards(8);

  const normalize = (s: string) =>
    (s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  function render() {
    const q = normalize(search.value.trim());
    const filtered = products.filter(
      (p) =>
        (selected === 'Todos' || p.category === selected) &&
        (!q || normalize(p.name).includes(q) || normalize(p.description).includes(q)),
    );

    chips.querySelectorAll<HTMLButtonElement>('[data-cat]').forEach((c) => {
      c.setAttribute('aria-pressed', String(c.dataset.cat === selected));
    });

    count.textContent =
      filtered.length === 1 ? '1 producto disponible' : `${filtered.length} productos disponibles`;
    empty.hidden = filtered.length > 0;
    setGridProducts(grid, filtered);
  }

  productsStore.loadProducts().then(() => {
    products = productsStore.getActiveProducts();
    const categories = [...new Set(products.map((p) => p.category).filter(Boolean))].sort();
    if (!categories.includes(selected)) selected = 'Todos';

    chips.innerHTML =
      `<button type="button" class="chip" data-cat="Todos">Todos</button>` +
      categories
        .map((c) => `<button type="button" class="chip" data-cat="${escapeHtml(c)}">${escapeHtml(c)}</button>`)
        .join('');
    render();
  });

  chips.addEventListener('click', (e) => {
    const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cat]');
    if (!chip) return;
    selected = chip.dataset.cat || 'Todos';
    const url = new URL(location.href);
    if (selected === 'Todos') url.searchParams.delete('categoria');
    else url.searchParams.set('categoria', selected);
    history.replaceState(null, '', url);
    render();
  });

  search.addEventListener('input', render);

  document.getElementById('clear-filters')?.addEventListener('click', () => {
    search.value = '';
    selected = 'Todos';
    render();
  });
</script>
