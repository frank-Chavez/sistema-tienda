---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { productsStore } from '../store/products.js';
import { cartStore } from '../store/cart.js';

// We mock an initial fetch for SSR, but we will mostly rely on client side hydrating,
// using our static fallback array for SEO/Initial load where possible.
---

<Layout
  title="Inicio"
  description="Bienvenido a NaturaBio, tu tienda naturista para un bienestar integral."
>
  <!-- Hero Section -->
  <section class="relative bg-purple-900 text-white overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-40">
      <img
        src="https://images.unsplash.com/photo-1542841791-afe382d33457?auto=format&fit=crop&q=80&w=2000"
        alt="Naturaleza"
        class="w-full h-full object-cover"
      />
    </div>
    <div
      class="absolute inset-0 bg-linear-to-r from-purple-900 via-purple-900/80 to-transparent z-0"
    >
    </div>

    <div
      class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-32 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
    >
      <div class="flex flex-col items-start animate-fade-in">
        <span
          class="bg-purple-500/30 text-purple-100 font-semibold px-4 py-1.5 rounded-full text-sm mb-6 backdrop-blur-sm border border-purple-400/30 inline-block"
          >100% Natural & Orgánico</span
        >
        <h1
          class="text-4xl md:text-6xl font-black mb-6 leading-tight text-white drop-shadow-lg"
        >
          El equilibrio de la naturaleza <span class="text-purple-300"
            >en tu hogar</span
          >
        </h1>
        <p
          class="text-lg md:text-xl mb-10 text-purple-100 leading-relaxed drop-shadow-md"
        >
          Descubre nuestra selección premium de productos naturales y orgánicos
          diseñados para potenciar tu salud física y mental sin químicos
          nocivos.
        </p>
        <div class="flex gap-4">
          <a
            href="/products"
            class="bg-white text-purple-900 px-8 py-4 rounded-xl font-bold hover:bg-purple-50 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1"
          >
            Ver Productos
          </a>
        </div>
      </div>

      <div
        class="relative hidden lg:flex justify-center items-center animate-fade-in"
        style="animation-delay: 200ms;"
      >
        <!-- Background Glows -->
        <div
          class="absolute w-96 h-96 bg-purple-500/30 blur-[120px] rounded-full animate-pulse"
        >
        </div>
        <div
          class="absolute w-80 h-80 bg-indigo-500/20 blur-[100px] rounded-full translate-x-32 -translate-y-32"
        >
        </div>

        <img
          src="/Niño Dios de Pumarume.png"
          alt="Niño Dios de Pumarume"
          class="relative z-10 w-full max-w-2xl drop-shadow-[0_30px_60px_rgba(168,85,247,0.5)] transition-all duration-700 ease-out animate-float"
        />
      </div>
    </div>
  </section>

  <style>
    @keyframes float {
      0%,
      100% {
        transform: translateY(0px) rotate(2deg);
      }
      50% {
        transform: translateY(-20px) rotate(0deg);
      }
    }
    .animate-float {
      animation: float 6s ease-in-out infinite;
    }
  </style>

  <!-- Info Section -->
  <section class="py-16 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center divide-y md:divide-y-0 md:divide-x divide-gray-100"
      >
        <div class="p-6">
          <div
            class="w-16 h-16 bg-purple-50 text-purple-600 rounded-full flex items-center justify-center mx-auto mb-6"
          >
            <svg
              class="w-8 h-8"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"
              ></path></svg
            >
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">
            Ingredientes Premium
          </h3>
          <p class="text-gray-500">
            Seleccionamos cuidadosamente cada ingrediente garantizando máxima
            pureza.
          </p>
        </div>
        <div class="p-6">
          <div
            class="w-16 h-16 bg-purple-50 text-purple-600 rounded-full flex items-center justify-center mx-auto mb-6"
          >
            <svg
              class="w-8 h-8"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path></svg
            >
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Sostenibilidad</h3>
          <p class="text-gray-500">
            Empaques ecofriendly y apoyo a productores locales de comercio
            justo.
          </p>
        </div>
        <div class="p-6">
          <div
            class="w-16 h-16 bg-purple-50 text-purple-600 rounded-full flex items-center justify-center mx-auto mb-6"
          >
            <svg
              class="w-8 h-8"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
            >
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">
            Calidad Certificada
          </h3>
          <p class="text-gray-500">
            Todos nuestros productos cuentan con registro y análisis de
            laboratorio..
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 bg-gray-50">
      <div class="flex justify-between items-end mb-12">
        <div>
          <h2 class="text-3xl font-black text-gray-900 mb-4 tracking-tight">
            Destacados
          </h2>
          <p class="text-gray-500 text-lg">
            Los productos favoritos de nuestra comunidad para tu bienestar.
          </p>
        </div>
        <a
          href="/products"
          class="hidden sm:inline-flex items-center gap-2 text-purple-600 font-semibold hover:text-purple-800 transition-colors"
        >
          Ver todo
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
          >
        </a>
      </div>

      <!-- We render initial state from server, client JS takes over if needed -->
      <!-- In a real Firebase setup, we might fetch here (if Astro SSR enabled) or pure CSR -->
      <div
        id="featured-grid"
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 min-h-100"
      >
        <!-- Initial skeleton or placeholder while JS loads -->
        <div class="col-span-full py-20 text-center text-gray-400">
          Cargando productos destacados...
        </div>
      </div>

      <div class="mt-10 text-center sm:hidden">
        <a
          href="/products"
          class="inline-flex w-full items-center justify-center gap-2 bg-purple-100 text-purple-700 font-semibold py-3 px-6 rounded-xl border border-purple-200"
        >
          Ver todos los productos
        </a>
      </div>
    </div>
  </section>
</Layout>

<script type="module">
  import { cartStore } from '/src/store/cart.js';
  import { productsStore } from '/src/store/products.js';

  document.addEventListener('DOMContentLoaded', () => {
    const grid = document.getElementById('featured-grid');

    // 🔥 CARGAR PRODUCTOS DESDE FIREBASE
    productsStore.loadProducts();

    function renderFeatured() {
      if (!grid) return;

      // SOLO 3 PRODUCTOS
      const products = productsStore.getActiveProducts().slice(0, 3);

      if (products.length === 0) {
        grid.innerHTML =
          '<div class="col-span-full py-20 text-center text-gray-500 font-medium">No hay productos disponibles.</div>';
        return;
      }

      grid.innerHTML = products
        .map(
          (prod) => `
      <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100 flex flex-col h-full group">
       
        <div class="relative h-64 overflow-hidden bg-gray-100">
          <img
            src="${prod.image}"
            alt="${prod.name}"
            class="w-full h-full object-contain object-center group-hover:scale-105 transition-transform duration-500"
          />

          <div class="absolute top-4 left-4 bg-white px-3 py-1 rounded-full text-xs font-semibold text-purple-700 border">
            ${prod.category}
          </div>
        </div>

        <div class="p-6 flex flex-col grow">

          <div class="flex justify-between mb-2">
            <h3 class="text-lg font-bold text-gray-900">
              ${prod.name}
            </h3>

            <span class="text-lg font-black text-purple-700">
              S/ ${parseFloat(prod.price).toFixed(2)}
            </span>
          </div>

          <p class="text-gray-500 text-sm mb-6 grow">
            ${prod.description}
          </p>

          <button
            data-product-id="${prod.id}"
            data-product-name="${prod.name}"
            data-product-price="${prod.price}"
            data-product-image="${prod.image}"
            data-product-stock="${prod.stock}"
            class="add-home-btn w-full bg-purple-600 hover:bg-purple-700 text-white py-3 rounded-xl flex items-center justify-center gap-2 group"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 transition-transform group-hover:scale-110"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
              />
            </svg>

            <span class="btn-text">Agregar al carrito</span>
          </button>

        </div>

      </div>
    `,
        )
        .join('');

      attachCartEvents();
    }

    function attachCartEvents() {
      const buttons = document.querySelectorAll('.add-home-btn');

      buttons.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const button = e.currentTarget;

          const id = button.dataset.productId;
          const name = button.dataset.productName;
          const price = parseFloat(button.dataset.productPrice || '0');
          const image = button.dataset.productImage;
          const stock = parseInt(button.dataset.productStock || '0');

          if (id && name && image) {
            cartStore.addItem({ id, name, price, image, stock }, 1);

            const text = button.querySelector('.btn-text');

            button.classList.replace('bg-purple-600', 'bg-green-500');

            if (text) text.textContent = '¡Agregado!';

            setTimeout(() => {
              button.classList.replace('bg-green-500', 'bg-purple-600');

              if (text) text.textContent = 'Agregar al carrito';
            }, 1500);
          }
        });
      });
    }

    renderFeatured();

    window.addEventListener('products_change', renderFeatured);
  });
</script>
