---
import Layout from '../layouts/Layout.astro';
import { STORE_PHONE } from '../lib/utils.js';

const waHref = `https://wa.me/${STORE_PHONE}?text=${encodeURIComponent('Hola, quisiera información sobre sus productos.')}`;

const steps = [
  { title: 'Elige tus productos', text: 'Revisa el catálogo y agrega al carrito lo que necesitas.' },
  { title: 'Revisa tu carrito', text: 'Ajusta las cantidades. El total se calcula al instante.' },
  { title: 'Envía el pedido', text: 'Se abre WhatsApp con tu lista lista para enviar. Coordinamos el pago y la entrega contigo.' },
];
---

<Layout title="Inicio">
  <!-- Portada -->
  <section class="relative overflow-hidden bg-ciruela text-white">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_70%_at_75%_40%,rgba(124,58,237,0.45),transparent_70%)]"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto grid max-w-7xl items-center gap-8 px-4 pb-14 pt-8 sm:px-6 md:pb-20 md:pt-14 lg:grid-cols-[1.05fr_1fr] lg:gap-12 lg:px-8 lg:pb-24">
      <!-- Hornacina con la imagen -->
      <div class="order-1 mx-auto w-full max-w-[15rem] sm:max-w-sm lg:order-2 lg:max-w-md">
        <div class="niche relative aspect-[4/5] animate-rise">
          <div class="absolute inset-0 rounded-t-full bg-gradient-to-b from-ciruela-2 via-[#4a1d8f] to-morado"></div>
          <div class="absolute inset-3 rounded-t-full border border-oro/70"></div>
          <div class="absolute inset-x-10 top-10 h-1/2 rounded-full bg-oro/25 blur-3xl"></div>
          <img
            src="/Niño Dios de Pumarume.png"
            alt="Imagen del Niño Dios de Pumarume con manto morado bordado en dorado"
            width="594"
            height="420"
            fetchpriority="high"
            class="absolute bottom-[6%] left-1/2 w-[128%] max-w-none -translate-x-1/2 drop-shadow-[0_24px_30px_rgba(20,5,40,0.55)]"
          />
        </div>
        <div class="mx-auto h-3 w-[86%] rounded-b-xl bg-oro/80"></div>
      </div>

      <!-- Texto -->
      <div class="order-2 text-center lg:order-1 lg:text-left">
        <p class="text-sm font-medium text-oro-claro sm:text-base">Tienda naturista en Santa Rosa</p>
        <h1 class="mt-3 text-[2.6rem] font-extrabold leading-[1.02] sm:text-6xl lg:text-7xl">
          Cuida tu salud con lo que da la tierra
        </h1>
        <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-white/75 lg:mx-0">
          Elige tus productos, arma tu carrito y envíanos el pedido por WhatsApp. Te respondemos para
          coordinar el pago y la entrega.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center lg:justify-start">
          <a href="/products" class="btn btn-gold h-12 px-7 text-base">Ver productos</a>
          <a
            href={waHref}
            target="_blank"
            rel="noopener"
            class="btn h-12 border border-white/25 px-7 text-base text-white hover:bg-white/10">Escribir por WhatsApp</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- Productos -->
  <section class="mx-auto max-w-7xl px-4 pt-14 sm:px-6 md:pt-20 lg:px-8">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 class="text-3xl font-bold sm:text-4xl">Disponibles ahora</h2>
        <p class="mt-2 text-gris">Productos con stock para pedir hoy.</p>
      </div>
      <a href="/products" class="btn btn-soft hidden sm:inline-flex">Ver todo el catálogo</a>
    </div>

    <div id="featured-grid" class="mt-8 grid grid-cols-2 gap-x-4 gap-y-8 sm:gap-x-6 md:grid-cols-3 lg:grid-cols-4"></div>
    <p id="featured-empty" hidden class="panel mt-8 p-10 text-center text-gris">
      Pronto tendremos productos disponibles. Escríbenos por WhatsApp y te contamos qué hay.
    </p>

    <a href="/products" class="btn btn-soft mt-8 w-full sm:hidden">Ver todo el catálogo</a>
  </section>

  <!-- Cómo pedir: es una secuencia real, por eso va numerada -->
  <section class="mx-auto max-w-7xl px-4 pt-20 sm:px-6 lg:px-8">
    <div class="rounded-[28px] bg-lavanda px-6 py-10 sm:px-10 md:py-14">
      <h2 class="text-3xl font-bold sm:text-4xl">Así haces tu pedido</h2>
      <ol class="mt-8 grid gap-8 md:grid-cols-3">
        {
          steps.map((s, i) => (
            <li class="flex gap-4">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-ciruela font-display text-lg font-bold text-oro-claro">
                {i + 1}
              </span>
              <div>
                <h3 class="text-lg font-semibold">{s.title}</h3>
                <p class="mt-1 leading-relaxed text-gris">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Layout>

<script>
  import { productsStore } from '../store/products.js';
  import { setGridProducts, skeletonCards } from '../lib/productCard.js';

  const grid = document.getElementById('featured-grid') as HTMLElement;
  const empty = document.getElementById('featured-empty') as HTMLElement;

  grid.innerHTML = skeletonCards(4);

  productsStore.loadProducts().then(() => {
    const products = productsStore.getActiveProducts().slice(0, 8);
    if (!products.length) {
      grid.innerHTML = '';
      empty.hidden = false;
      return;
    }
    setGridProducts(grid, products);
  });
</script>
