---
import Layout from '../layouts/Layout.astro';
import AuthShell from '../components/AuthShell.astro';
import PasswordField from '../components/PasswordField.astro';
---

<Layout title="Crear cuenta" description="Crea tu cuenta en E.F.D.">
  <AuthShell heading="Crea tu cuenta">
    <p class="mt-2 text-gris">
      ¿Ya tienes una? <a href="/login" data-keep-redirect class="font-semibold text-morado hover:underline">Inicia sesión</a>
    </p>

    <div id="form-message" hidden role="alert" class="mt-6 rounded-2xl bg-[#fdecea] px-4 py-3 text-sm font-medium text-[#b42318]"></div>

    <form id="register-form" class="mt-6 space-y-5" novalidate>
      <div>
        <label for="nombre" class="label">Nombre y apellido</label>
        <input id="nombre" type="text" autocomplete="name" required maxlength="60" class="field" placeholder="Ej. Rosa Quispe" />
      </div>
      <div>
        <label for="email" class="label">Correo electrónico</label>
        <input id="email" type="email" autocomplete="email" inputmode="email" required class="field" placeholder="tu@correo.com" />
      </div>
      <PasswordField id="password" label="Contraseña" autocomplete="new-password" placeholder="Mínimo 6 caracteres" minlength={6} />

      <button id="submit-btn" type="submit" class="btn btn-primary h-12 w-full text-base">Crear cuenta</button>
    </form>
  </AuthShell>
</Layout>

<script>
  import { authStore } from '../store/auth.js';
  import { safeRedirect } from '../lib/utils.js';

  const redirectParam = new URLSearchParams(location.search).get('redirect');
  if (redirectParam) {
    document.querySelectorAll<HTMLAnchorElement>('[data-keep-redirect]').forEach((a) => {
      a.href += `?redirect=${encodeURIComponent(safeRedirect(redirectParam))}`;
    });
  }

  const form = document.getElementById('register-form') as HTMLFormElement;
  const nombre = document.getElementById('nombre') as HTMLInputElement;
  const email = document.getElementById('email') as HTMLInputElement;
  const password = document.getElementById('password') as HTMLInputElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const msg = document.getElementById('form-message') as HTMLElement;

  const fail = (text: string, field?: HTMLInputElement) => {
    msg.textContent = text;
    msg.hidden = false;
    field?.focus();
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    msg.hidden = true;

    if (!nombre.value.trim()) return fail('Escribe tu nombre.', nombre);
    if (!email.validity.valid || !email.value) return fail('Escribe un correo válido.', email);
    if (password.value.length < 6) return fail('La contraseña debe tener al menos 6 caracteres.', password);

    submitBtn.disabled = true;
    submitBtn.textContent = 'Creando cuenta…';
    const result = await authStore.register(nombre.value.trim(), email.value.trim(), password.value);
    if (result.success) {
      location.href = safeRedirect(redirectParam, '/');
    } else {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Crear cuenta';
      fail(result.message);
    }
  });
</script>
