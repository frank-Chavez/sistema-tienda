---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Usuarios">
  <h1 class="text-3xl font-bold sm:text-4xl">Usuarios</h1>
  <p id="users-count" class="mt-1 text-gris">&nbsp;</p>

  <label class="mt-6 block sm:max-w-sm">
    <span class="sr-only">Buscar usuario</span>
    <input id="search" type="search" class="field rounded-full" placeholder="Buscar por nombre o correo" />
  </label>

  <ul id="users-list" class="panel mt-5 divide-y divide-borde">
    <li class="p-5"><div class="skeleton h-10"></div></li>
  </ul>
</AdminLayout>

<script>
  import { requireAdmin } from '../../lib/adminGuard.js';
  import { getUsers, deleteUser } from '../../lib/firebaseUsers.js';
  import { showToast } from '../../lib/toast.js';
  import { escapeHtml } from '../../lib/utils.js';

  const list = document.getElementById('users-list') as HTMLElement;
  const search = document.getElementById('search') as HTMLInputElement;
  let users: any[] = [];

  function render() {
    const q = search.value.trim().toLowerCase();
    const visible = users.filter((u) => !q || `${u.nombre} ${u.email}`.toLowerCase().includes(q));
    const clientes = users.filter((u) => u.rol !== 'admin').length;
    (document.getElementById('users-count') as HTMLElement).textContent =
      `${clientes} clientes y ${users.length - clientes} administradores`;

    list.innerHTML = visible.length
      ? visible
          .map((u) => {
            const isAdmin = u.rol === 'admin';
            const inicial = escapeHtml((u.nombre || u.email || '?').trim().charAt(0).toUpperCase());
            return `
        <li class="flex items-center gap-4 p-4" data-id="${escapeHtml(u.id)}">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full ${isAdmin ? 'bg-ciruela text-oro-claro' : 'bg-lavanda text-morado'} font-display font-bold">${inicial}</span>
          <div class="min-w-0 grow">
            <p class="truncate font-semibold">${escapeHtml(u.nombre || 'Sin nombre')}</p>
            <p class="truncate text-sm text-gris">${escapeHtml(u.email || '')}</p>
          </div>
          ${
            isAdmin
              ? '<span class="badge bg-ciruela text-oro-claro">Administrador</span>'
              : '<button type="button" data-delete class="btn btn-danger h-9 min-h-9 shrink-0 px-3 text-sm">Eliminar</button>'
          }
        </li>`;
          })
          .join('')
      : '<li class="p-8 text-center text-gris">No hay usuarios que coincidan.</li>';
  }

  search.addEventListener('input', render);

  list.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('[data-delete]');
    const row = btn?.closest<HTMLElement>('[data-id]');
    const user = users.find((u) => u.id === row?.dataset.id);
    if (!user || user.rol === 'admin') return;

    const ok = await (window as any).showConfirm(
      'Eliminar usuario',
      `Se borrarán los datos de ${user.nombre || user.email} en la tienda. Su acceso de Firebase se elimina desde la consola de Firebase.`,
    );
    if (!ok) return;
    try {
      await deleteUser(user.id);
      users = users.filter((u) => u.id !== user.id);
      render();
      showToast('Usuario eliminado', 'success');
    } catch (error) {
      console.error(error);
      showToast('No se pudo eliminar el usuario.', 'error');
    }
  });

  async function init() {
    await requireAdmin();
    users = (await getUsers()).sort((a: any, b: any) =>
      a.rol === b.rol ? String(a.nombre).localeCompare(String(b.nombre)) : a.rol === 'admin' ? -1 : 1,
    );
    render();
  }
  init();
</script>
