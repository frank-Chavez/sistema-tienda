---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Productos">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-3xl font-bold sm:text-4xl">Productos</h1>
      <p id="products-count" class="mt-1 text-gris">&nbsp;</p>
    </div>
    <button id="btn-add" type="button" class="btn btn-primary">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
      Nuevo producto
    </button>
  </div>

  <label class="relative mt-6 block sm:max-w-sm">
    <span class="sr-only">Buscar producto</span>
    <input id="search" type="search" class="field rounded-full" placeholder="Buscar por nombre o categoría" />
  </label>

  <ul id="products-list" class="mt-5 grid gap-3 xl:grid-cols-2">
    <li class="skeleton h-24"></li>
    <li class="skeleton h-24"></li>
  </ul>

  <div id="product-modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-sheet modal-wide">
      <div class="sticky top-0 z-10 flex items-center justify-between border-b border-borde bg-white p-5 sm:p-6">
        <h2 id="modal-title" class="text-2xl font-bold">Nuevo producto</h2>
        <button type="button" data-close aria-label="Cerrar" class="flex h-10 w-10 items-center justify-center rounded-full hover:bg-lavanda">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"></path></svg>
        </button>
      </div>

      <form id="product-form" class="space-y-5 p-5 sm:p-6">
        <input type="hidden" id="form-id" />
        <fieldset>
          <legend class="label">Foto del producto</legend>
          <div class="flex gap-4">
            <div class="relative flex h-28 w-28 shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-lavanda sm:h-32 sm:w-32">
              <svg id="preview-empty" class="h-9 w-9 text-[#b9a6dc]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4V8Z"></path><circle cx="12" cy="13" r="3.5"></circle></svg>
              <img id="form-preview" alt="Vista previa de la foto" class="absolute inset-0 hidden h-full w-full object-contain p-1 mix-blend-multiply" />
              <div id="photo-busy" hidden class="absolute inset-0 flex items-center justify-center bg-white/80">
                <div class="h-7 w-7 animate-spin rounded-full border-[3px] border-lavanda border-t-morado"></div>
              </div>
            </div>
            <div class="flex grow flex-col justify-center gap-2">
              <!-- capture="environment" abre directamente la cámara trasera en el celular -->
              <label class="btn btn-primary w-full cursor-pointer">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M4 8h3l2-3h6l2 3h3v11H4V8Z"></path><circle cx="12" cy="13" r="3.5"></circle></svg>
                Tomar foto
                <input id="photo-camera" type="file" accept="image/*" capture="environment" class="sr-only" />
              </label>
              <label class="btn btn-soft w-full cursor-pointer">
                Elegir de la galería
                <input id="photo-gallery" type="file" accept="image/*" class="sr-only" />
              </label>
              <button id="photo-remove" type="button" hidden class="text-sm font-semibold text-[#b42318] hover:underline">Quitar foto</button>
            </div>
          </div>
          <p id="photo-hint" class="mt-2 text-sm text-gris">Toma la foto con buena luz y el producto centrado, sobre un fondo liso.</p>
          <details id="url-box" class="mt-3">
            <summary class="cursor-pointer text-sm font-semibold text-morado">O usar un enlace de internet</summary>
            <input type="url" id="form-image" class="field mt-2" placeholder="https://…" />
          </details>
        </fieldset>
        <div>
          <label for="form-name" class="label">Nombre</label>
          <input type="text" id="form-name" required maxlength="80" class="field" placeholder="Ej. Aloe vera orgánico" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="form-price" class="label">Precio (S/)</label>
            <input type="number" inputmode="decimal" step="0.01" min="0" id="form-price" required class="field" placeholder="0.00" />
          </div>
          <div>
            <label for="form-stock" class="label">Stock</label>
            <input type="number" inputmode="numeric" step="1" min="0" id="form-stock" required class="field" placeholder="10" />
          </div>
          <div>
            <label for="form-category" class="label">Categoría</label>
            <select id="form-category" required class="field"></select>
          </div>
          <div>
            <label for="form-status" class="label">Estado</label>
            <select id="form-status" class="field">
              <option value="activo">Visible en tienda</option>
              <option value="inactivo">Oculto</option>
            </select>
          </div>
        </div>
        <div>
          <label for="form-description" class="label">Descripción</label>
          <textarea id="form-description" required rows="4" class="field resize-none" placeholder="Para qué sirve, presentación, modo de uso…"></textarea>
        </div>
        <div class="flex flex-col-reverse gap-3 border-t border-borde pt-5 sm:flex-row sm:justify-end">
          <button type="button" data-close class="btn btn-outline">Cancelar</button>
          <button id="form-submit" type="submit" class="btn btn-primary">Guardar producto</button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  import { requireAdmin } from '../../lib/adminGuard.js';
  import { getCategories } from '../../lib/firebaseCategories.js';
  import { getProducts, createProduct, deleteProduct, updateProduct } from '../../lib/firebaseProducts.js';
  import { showToast } from '../../lib/toast.js';
  import { openModal, closeModal, wireModal } from '../../lib/modal.js';
  import { escapeHtml, formatPrice } from '../../lib/utils.js';
  import { compressImage, isDataImage } from '../../lib/imageCompress.js';

  const $ = <T extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as T;
  const list = $<HTMLElement>('products-list');
  const modal = $<HTMLElement>('product-modal');
  const form = $<HTMLFormElement>('product-form');
  const preview = $<HTMLImageElement>('form-preview');
  const submitBtn = $<HTMLButtonElement>('form-submit');
  const search = $('search');
  wireModal(modal);

  let products: any[] = [];
  let categories: any[] = [];

  function render() {
    const q = search.value.trim().toLowerCase();
    const visible = products.filter(
      (p) => !q || `${p.nombre} ${p.categoria}`.toLowerCase().includes(q),
    );
    $<HTMLElement>('products-count').textContent = `${products.length} productos registrados`;

    if (!visible.length) {
      list.innerHTML = `<li class="panel p-10 text-center text-gris xl:col-span-2">${
        products.length ? 'Ningún producto coincide con la búsqueda.' : 'Aún no hay productos. Crea el primero.'
      }</li>`;
      return;
    }

    list.innerHTML = visible
      .map((p) => {
        const stock = Number(p.stock) || 0;
        const visibleEnTienda = p.estado === 'activo' && stock > 0;
        return `
      <li class="panel flex gap-4 p-4" data-id="${escapeHtml(p.id)}">
        <div class="h-20 w-20 shrink-0 overflow-hidden rounded-2xl bg-lavanda">
          <img src="${escapeHtml(p.imagen)}" alt="" loading="lazy" class="h-full w-full object-contain p-1 mix-blend-multiply" />
        </div>
        <div class="flex min-w-0 grow flex-col">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="truncate font-semibold">${escapeHtml(p.nombre)}</p>
              <p class="text-sm text-gris">${escapeHtml(p.categoria || 'Sin categoría')}</p>
            </div>
            <p class="shrink-0 font-display text-lg font-bold text-morado">${formatPrice(p.precio)}</p>
          </div>
          <div class="mt-auto flex flex-wrap items-center gap-2 pt-2">
            <span class="badge ${stock === 0 ? 'badge-cancelado' : stock <= 5 ? 'badge-pendiente' : 'badge-completado'}">${stock === 0 ? 'Agotado' : `${stock} en stock`}</span>
            <span class="badge ${visibleEnTienda ? 'bg-lavanda text-morado' : 'bg-gray-100 text-gris'}">${visibleEnTienda ? 'Visible' : 'Oculto'}</span>
            <span class="ml-auto flex gap-1">
              <button type="button" data-edit class="btn btn-soft h-9 min-h-9 px-3 text-sm">Editar</button>
              <button type="button" data-delete class="btn btn-danger h-9 min-h-9 px-3 text-sm">Eliminar</button>
            </span>
          </div>
        </div>
      </li>`;
      })
      .join('');
  }

  function fillCategories(selectedValue = '') {
    const select = $<HTMLSelectElement>('form-category');
    const names = categories.map((c) => c.nombre);
    if (selectedValue && !names.includes(selectedValue)) names.push(selectedValue);
    select.innerHTML = names.length
      ? names.map((n) => `<option value="${escapeHtml(n)}">${escapeHtml(n)}</option>`).join('')
      : '<option value="">Primero crea una categoría</option>';
    if (selectedValue) select.value = selectedValue;
  }

  // Imagen actual del formulario: una foto comprimida (data URL) o un enlace.
  let photoData = '';

  function currentImage() {
    return photoData || $('form-image').value.trim();
  }

  function updatePreview() {
    const src = currentImage();
    preview.classList.toggle('hidden', !src);
    $<HTMLElement>('preview-empty').classList.toggle('hidden', !!src);
    $<HTMLElement>('photo-remove').hidden = !photoData;
    if (src) preview.src = src;
  }
  $('form-image').addEventListener('input', () => {
    if ($('form-image').value.trim()) photoData = '';
    updatePreview();
  });
  preview.addEventListener('error', () => {
    preview.classList.add('hidden');
    $<HTMLElement>('preview-empty').classList.remove('hidden');
  });

  async function handlePhoto(input: HTMLInputElement) {
    const file = input.files?.[0];
    input.value = ''; // permite volver a elegir la misma foto
    if (!file) return;

    const busy = $<HTMLElement>('photo-busy');
    const hint = $<HTMLElement>('photo-hint');
    busy.hidden = false;
    submitBtn.disabled = true;
    try {
      photoData = await compressImage(file);
      $('form-image').value = '';
      const kb = Math.round((photoData.length * 3) / 4 / 1024);
      hint.textContent = `Foto lista (${kb} KB). Se guardará al tocar "Guardar producto".`;
      updatePreview();
    } catch (error: any) {
      console.error(error);
      showToast(error?.message || 'No se pudo usar esa foto. Prueba con otra.', 'error');
    } finally {
      busy.hidden = true;
      submitBtn.disabled = false;
    }
  }
  $('photo-camera').addEventListener('change', (e) => handlePhoto(e.currentTarget as HTMLInputElement));
  $('photo-gallery').addEventListener('change', (e) => handlePhoto(e.currentTarget as HTMLInputElement));
  $('photo-remove').addEventListener('click', () => {
    photoData = '';
    $<HTMLElement>('photo-hint').textContent =
      'Toma la foto con buena luz y el producto centrado, sobre un fondo liso.';
    updatePreview();
  });

  function openForm(product?: any) {
    form.reset();
    $('form-id').value = product?.id || '';
    $<HTMLElement>('modal-title').textContent = product ? 'Editar producto' : 'Nuevo producto';
    fillCategories(product?.categoria || '');
    if (product) {
      $('form-name').value = product.nombre || '';
      $('form-price').value = product.precio ?? '';
      $('form-stock').value = product.stock ?? '';
      $<HTMLSelectElement>('form-status').value = product.estado || 'activo';
      $<HTMLTextAreaElement>('form-description').value = product.descripcion || '';
    }
    // Si el producto ya tenía una foto subida, se conserva; si era un enlace, va al campo de enlace.
    photoData = isDataImage(product?.imagen) ? product.imagen : '';
    $('form-image').value = photoData ? '' : product?.imagen || '';
    ($<HTMLDetailsElement>('url-box')).open = !!$('form-image').value;
    $<HTMLElement>('photo-hint').textContent =
      'Toma la foto con buena luz y el producto centrado, sobre un fondo liso.';
    updatePreview();
    openModal(modal);
  }

  $('btn-add').addEventListener('click', () => openForm());
  search.addEventListener('input', render);

  list.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const row = target.closest<HTMLElement>('[data-id]');
    const product = products.find((p) => p.id === row?.dataset.id);
    if (!product) return;

    if (target.closest('[data-edit]')) openForm(product);

    if (target.closest('[data-delete]')) {
      const ok = await (window as any).showConfirm(
        'Eliminar producto',
        `"${product.nombre}" dejará de aparecer en la tienda. Esta acción no se puede deshacer.`,
      );
      if (!ok) return;
      try {
        await deleteProduct(product.id);
        products = products.filter((p) => p.id !== product.id);
        render();
        showToast('Producto eliminado', 'success');
      } catch (error) {
        console.error(error);
        showToast('No se pudo eliminar el producto.', 'error');
      }
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;

    const id = $('form-id').value;
    const product = {
      nombre: $('form-name').value.trim(),
      precio: Math.max(0, Number($('form-price').value) || 0),
      stock: Math.max(0, Math.floor(Number($('form-stock').value) || 0)),
      categoria: $<HTMLSelectElement>('form-category').value,
      estado: $<HTMLSelectElement>('form-status').value,
      imagen: currentImage(),
      descripcion: $<HTMLTextAreaElement>('form-description').value.trim(),
    };
    if (!product.imagen) {
      showToast('Agrega una foto del producto o pega un enlace.', 'warning');
      return;
    }
    if (!product.categoria) {
      showToast('Primero crea una categoría en la sección Categorías.', 'warning');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Guardando…';
    try {
      if (id) {
        await updateProduct(id, product);
        showToast('Producto actualizado', 'success');
      } else {
        await createProduct(product);
        showToast('Producto creado', 'success');
      }
      closeModal(modal);
      products = await getProducts();
      render();
    } catch (error) {
      console.error(error);
      showToast('No se pudo guardar. Revisa tu conexión e intenta de nuevo.', 'error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Guardar producto';
    }
  });

  async function init() {
    await requireAdmin();
    [products, categories] = await Promise.all([getProducts(), getCategories()]);
    products.sort((a, b) => String(a.nombre).localeCompare(String(b.nombre)));
    render();
  }
  init();
</script>
