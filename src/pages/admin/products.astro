---
import Layout from '../../layouts/Layout.astro';
import AdminSidebar from '../../components/AdminSidebar.astro';
import ConfirmModal from '../../components/ConfirmModal.astro';
import { authStore } from '../../store/auth.js';
import { showToast } from '../../lib/toast.js';
import { getCategories } from '../../lib/firebaseCategories.js';
import {
  getProducts,
  createProduct,
  deleteProduct,
  updateProduct,
} from '../../lib/firebaseProducts.js';
---

<Layout
  title="Gestión de Productos"
  description="Administra tu catálogo de productos"
>
  <div class="flex bg-gray-50 min-h-screen">
    <AdminSidebar />

    <main class="grow p-4 md:p-8 w-full max-w-full overflow-hidden relative">
      <script type="module">
        import { authStore } from '../../store/auth.js';

        if (!authStore.isAdmin()) {
          window.location.href = '/login';
        }
      </script>

      <div
        class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4"
      >
        <div>
          <h1 class="text-3xl font-black text-gray-900 tracking-tight">
            Menú de Productos
          </h1>
          <p class="text-gray-500 mt-1">
            Añade, edita y elimina productos de tu tienda.
          </p>
        </div>
        <button
          id="btn-add-product"
          class="bg-purple-600 hover:bg-purple-700 text-white font-bold py-2.5 px-5 rounded-xl transition-colors shadow-sm shadow-purple-200 flex items-center gap-2"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 4v16m8-8H4"></path></svg
          >
          Nuevo Producto
        </button>
      </div>

      <!-- Products Table -->
      <div
        class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden min-h-[50vh]"
      >
        <div class="overflow-x-auto w-full">
          <table class="w-full text-left border-collapse min-w-200">
            <thead>
              <tr
                class="bg-gray-50 text-gray-500 text-sm border-b border-gray-100"
              >
                <th class="py-4 px-6 font-semibold w-16">Imagen</th>
                <th class="py-4 px-6 font-semibold">Producto</th>
                <th class="py-4 px-6 font-semibold w-24">Precio</th>
                <th class="py-4 px-6 font-semibold w-24">Stock</th>
                <th class="py-4 px-6 font-semibold w-32">Estado</th>
                <th class="py-4 px-6 font-semibold w-32 text-right">Acciones</th
                >
              </tr>
            </thead>
            <tbody
              id="products-tbody"
              class="divide-y divide-gray-100 align-middle text-gray-700"
            >
              <!-- Populated by JS -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Modal Overlay (Hidden by default) -->
      <div
        id="product-modal"
        class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4 opacity-0 transition-opacity duration-300"
      >
        <div
          class="bg-white rounded-3xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto transform scale-95 transition-transform duration-300"
          id="modal-content"
        >
          <div
            class="p-6 sm:p-8 border-b border-gray-100 flex justify-between items-center sticky top-0 bg-white z-10"
          >
            <h2 id="modal-title" class="text-2xl font-black text-gray-900">
              Agregar Producto
            </h2>
            <button
              id="btn-close-modal"
              class="text-gray-400 hover:text-gray-700 transition-colors p-2 rounded-full hover:bg-gray-100"
            >
              <svg
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"></path></svg
              >
            </button>
          </div>

          <form id="product-form" class="p-6 sm:p-8 space-y-6">
            <input type="hidden" id="form-id" />

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div class="sm:col-span-2">
                <label class="block text-sm font-semibold text-gray-700 mb-2"
                  >Nombre del Producto</label
                >
                <input
                  type="text"
                  id="form-name"
                  required
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-600 focus:border-transparent transition-all outline-none bg-gray-50 focus:bg-white"
                  placeholder="Ej. Aloe Vera Orgánico"
                />
              </div>

              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2"
                  >Precio (S/)</label
                >
                <input
                  type="number"
                  step="0.01"
                  id="form-price"
                  required
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-600 focus:border-transparent transition-all outline-none bg-gray-50 focus:bg-white"
                  placeholder="0.00"
                />
              </div>

              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2"
                  >Stock (unidades)</label
                >
                <input
                  type="number"
                  id="form-stock"
                  required
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-600 focus:border-transparent transition-all outline-none bg-gray-50 focus:bg-white"
                  placeholder="10"
                />
              </div>

              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2"
                  >Categoría</label
                >
                <select
                  id="form-category"
                  required
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-600 focus:border-transparent transition-all outline-none bg-gray-50 focus:bg-white text-gray-700"
                >
                </select>
              </div>

              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2"
                  >Estado</label
                >
                <select
                  id="form-status"
                  required
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-600 focus:border-transparent transition-all outline-none bg-gray-50 focus:bg-white text-gray-700"
                >
                  <option value="activo">Activo</option>
                  <option value="inactivo">Inactivo</option>
                </select>
              </div>

              <div class="sm:col-span-2">
                <label class="block text-sm font-semibold text-gray-700 mb-2"
                  >URL de la Imagen</label
                >
                <input
                  type="url"
                  id="form-image"
                  required
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-600 focus:border-transparent transition-all outline-none bg-gray-50 focus:bg-white"
                  placeholder="https://..."
                />
              </div>

              <div class="sm:col-span-2">
                <label class="block text-sm font-semibold text-gray-700 mb-2"
                  >Descripción</label
                >
                <textarea
                  id="form-description"
                  required
                  rows="4"
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-600 focus:border-transparent transition-all outline-none bg-gray-50 focus:bg-white resize-none"
                  placeholder="Breve descripción del producto..."></textarea>
              </div>
            </div>

            <div class="pt-6 border-t border-gray-100 flex justify-end gap-3">
              <button
                type="button"
                id="btn-cancel-modal"
                class="px-6 py-2.5 rounded-xl font-semibold text-gray-700 hover:bg-gray-100 transition-colors"
                >Cancelar</button
              >
              <button
                type="submit"
                class="px-6 py-2.5 rounded-xl font-bold bg-purple-600 text-white hover:bg-purple-700 hover:shadow-lg hover:shadow-purple-200 transition-all active:scale-[0.98]"
                >Guardar Producto</button
              >
            </div>
          </form>
        </div>
      </div>

      <ConfirmModal id="delete-product-modal" />
    </main>
  </div>
</Layout>

<script type="module">
  import { authStore } from '../../store/auth.js';
  import { getCategories } from '../../lib/firebaseCategories.js';
  import {
    getProducts,
    createProduct,
    deleteProduct,
    updateProduct,
  } from '../../lib/firebaseProducts.js';

  // Toast function inlined to avoid import issues in static builds
  function showToast(message, type = 'info', duration = 3200) {
    if (typeof window === 'undefined') return;

    let container = document.getElementById('global-toast-container');

    if (!container) {
      container = document.createElement('div');
      container.id = 'global-toast-container';
      container.style.position = 'fixed';
      container.style.top = '1rem';
      container.style.right = '1rem';
      container.style.zIndex = 9999;
      container.style.display = 'flex';
      container.style.flexDirection = 'column';
      container.style.gap = '0.5rem';
      document.body.appendChild(container);
    }

    const toast = document.createElement('div');
    toast.style.minWidth = '240px';
    toast.style.padding = '12px 14px';
    toast.style.borderRadius = '10px';
    toast.style.color = '#ffffff';
    toast.style.boxShadow = '0 8px 22px rgba(0, 0, 0, 0.16)';
    toast.style.fontSize = '0.9rem';
    toast.style.fontWeight = '600';
    toast.style.opacity = '0';
    toast.style.transform = 'translateX(20px)';
    toast.style.transition = 'opacity 220ms ease, transform 220ms ease';

    let backgroundColor = '#06b6d4';
    if (type === 'success') backgroundColor = '#10b981';
    if (type === 'warning') backgroundColor = '#f59e0b';
    if (type === 'error') backgroundColor = '#ef4444';

    toast.style.backgroundColor = backgroundColor;
    toast.textContent = message;

    container.appendChild(toast);

    requestAnimationFrame(() => {
      toast.style.opacity = '1';
      toast.style.transform = 'translateX(0)';
    });

    const hide = () => {
      toast.style.opacity = '0';
      toast.style.transform = 'translateX(20px)';
      setTimeout(() => {
        if (toast.parentElement) toast.parentElement.removeChild(toast);
      }, 220);
    };

    setTimeout(hide, duration);
  }

  const tbody = document.getElementById('products-tbody');

  const modal = document.getElementById('product-modal');
  const modalContent = document.getElementById('modal-content');

  const btnAdd = document.getElementById('btn-add-product');
  const btnClose = document.getElementById('btn-close-modal');
  const btnCancel = document.getElementById('btn-cancel-modal');

  const form = document.getElementById('product-form');

  // ==========================
  // CARGAR PRODUCTOS
  // ==========================
  async function renderProducts() {
    const products = await getProducts();

    if (!products.length) {
      tbody.innerHTML = `
      <tr>
        <td colspan="6" class="p-10 text-center">
          No hay productos
        </td>
      </tr>
    `;
      return;
    }

    tbody.innerHTML = products
      .map(
        (p) => `
      <tr>
        <td class="p-4">
          <img src="${p.imagen}" class="w-12 h-12 object-cover rounded">
        </td>
        <td class="p-4 font-bold">${p.nombre}</td>
        <td class="p-4">S/ ${p.precio}</td>
        <td class="p-4">${p.stock}</td>
        <td class="p-4">${p.estado}</td>
        <td class="p-4 text-right space-x-2">
          <button data-id="${p.id}" class="view-btn text-blue-600">Ver</button>
          <button data-id="${p.id}" class="edit-btn text-yellow-600">Editar</button>
          <button data-id="${p.id}" class="delete-btn text-red-600">Eliminar</button>
        </td>
      </tr>
    `,
      )
      .join('');

    // ======================
    // ELIMINAR
    // ======================
    document.querySelectorAll('.delete-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const id = e.target.dataset.id;

        const confirmResult = await showConfirm(
          'Eliminar producto',
          '¿Eliminar producto? Esta acción es irreversible.',
          'Sí, eliminar',
          'Cancelar',
        );
        if (confirmResult) {
          await deleteProduct(id);
          showToast('Producto eliminado', 'success');
          renderProducts();
        }
      });
    });

    // ======================
    // EDITAR
    // ======================
    document.querySelectorAll('.edit-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const id = e.target.dataset.id;
        const product = products.find((p) => p.id === id);

        if (!product) return;

        document.getElementById('form-id').value = product.id;
        document.getElementById('form-name').value = product.nombre;
        document.getElementById('form-price').value = product.precio;
        document.getElementById('form-stock').value = product.stock;
        document.getElementById('form-category').value = product.categoria;
        document.getElementById('form-status').value = product.estado;
        document.getElementById('form-image').value = product.imagen;
        document.getElementById('form-description').value = product.descripcion;

        openModal();
      });
    });

    // ======================
    // VER (simple)
    // ======================
    document.querySelectorAll('.view-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const id = e.target.dataset.id;
        const product = products.find((p) => p.id === id);

        if (!product) return;

        showToast(
          `Nombre: ${product.nombre} · Precio: S/ ${product.precio} · Stock: ${product.stock} · Categoría: ${product.categoria} · Estado: ${product.estado} · Descripción: ${product.descripcion}`,
          'info',
          6000,
        );
      });
    });
  }

  // ==========================
  // CATEGORÍAS
  // ==========================
  async function loadCategories() {
    const select = document.getElementById('form-category');
    const categories = await getCategories();

    if (!categories.length) {
      select.innerHTML = `<option>No hay categorías</option>`;
      return;
    }

    select.innerHTML = categories
      .map((c) => `<option value="${c.nombre}">${c.nombre}</option>`)
      .join('');
  }

  // ==========================
  // MODAL
  // ==========================
  function openModal() {
    modal.classList.remove('hidden');

    setTimeout(() => {
      modal.classList.remove('opacity-0');
      modalContent.classList.remove('scale-95');
    }, 10);
  }

  function closeModal() {
    modal.classList.add('opacity-0');
    modalContent.classList.add('scale-95');

    setTimeout(() => {
      modal.classList.add('hidden');
    }, 300);
  }

  btnAdd.addEventListener('click', () => {
    form.reset();
    document.getElementById('form-id').value = '';
    openModal();
  });

  btnClose.addEventListener('click', closeModal);
  btnCancel.addEventListener('click', closeModal);

  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // ==========================
  // GUARDAR (CREATE + UPDATE)
  // ==========================
  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const id = document.getElementById('form-id').value;

    const product = {
      nombre: document.getElementById('form-name').value,
      precio: Number(document.getElementById('form-price').value),
      stock: Number(document.getElementById('form-stock').value),
      categoria: document.getElementById('form-category').value,
      estado: document.getElementById('form-status').value,
      imagen: document.getElementById('form-image').value,
      descripcion: document.getElementById('form-description').value,
    };

    try {
      if (id) {
        await updateProduct(id, product); // 👈 EDITAR
        showToast('Producto actualizado', 'success');
      } else {
        await createProduct(product); // 👈 CREAR
        showToast('Producto creado', 'success');
      }
      form.reset();
      closeModal();
      renderProducts();
    } catch (error) {
      console.error(error);
    }
  });

  // ==========================
  // INIT
  // ==========================
  renderProducts();
  loadCategories();
</script>
