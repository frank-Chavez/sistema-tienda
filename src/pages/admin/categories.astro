---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Categorías">
  <h1 class="text-3xl font-bold sm:text-4xl">Categorías</h1>
  <p class="mt-1 text-gris">Agrupan los productos en la tienda y aparecen como filtros.</p>

  <form id="category-form" class="mt-6 flex max-w-xl gap-2">
    <label for="cat-name" class="sr-only">Nombre de la nueva categoría</label>
    <input id="cat-name" type="text" required maxlength="40" class="field" placeholder="Nueva categoría, ej. Infusiones" />
    <button id="cat-submit" type="submit" class="btn btn-primary h-12 shrink-0">Agregar</button>
  </form>

  <ul id="categories-list" class="panel mt-6 max-w-xl divide-y divide-borde">
    <li class="p-5"><div class="skeleton h-6"></div></li>
  </ul>
</AdminLayout>

<script>
  import { requireAdmin } from '../../lib/adminGuard.js';
  import { getCategories, createCategory, deleteCategory } from '../../lib/firebaseCategories.js';
  import { getProducts } from '../../lib/firebaseProducts.js';
  import { showToast } from '../../lib/toast.js';
  import { escapeHtml } from '../../lib/utils.js';

  const list = document.getElementById('categories-list') as HTMLElement;
  const form = document.getElementById('category-form') as HTMLFormElement;
  const input = document.getElementById('cat-name') as HTMLInputElement;
  const submit = document.getElementById('cat-submit') as HTMLButtonElement;

  let categories: any[] = [];
  let counts: Record<string, number> = {};

  function render() {
    list.innerHTML = categories.length
      ? categories
          .map(
            (c) => `
        <li class="flex items-center justify-between gap-4 p-4 pl-5" data-id="${escapeHtml(c.id)}">
          <div>
            <p class="font-semibold">${escapeHtml(c.nombre)}</p>
            <p class="text-sm text-gris">${counts[c.nombre] || 0} productos</p>
          </div>
          <button type="button" data-delete class="btn btn-danger h-9 min-h-9 px-3 text-sm">Eliminar</button>
        </li>`,
          )
          .join('')
      : '<li class="p-8 text-center text-gris">Aún no hay categorías. Agrega la primera arriba.</li>';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const nombre = input.value.trim();
    if (!nombre) return;
    if (categories.some((c) => c.nombre.toLowerCase() === nombre.toLowerCase())) {
      showToast('Esa categoría ya existe', 'warning');
      return;
    }
    submit.disabled = true;
    try {
      await createCategory({ nombre });
      form.reset();
      categories = await getCategories();
      render();
      showToast('Categoría agregada', 'success');
    } catch (error) {
      console.error(error);
      showToast('No se pudo agregar la categoría.', 'error');
    } finally {
      submit.disabled = false;
    }
  });

  list.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('[data-delete]');
    const row = btn?.closest<HTMLElement>('[data-id]');
    const cat = categories.find((c) => c.id === row?.dataset.id);
    if (!cat) return;

    const n = counts[cat.nombre] || 0;
    const ok = await (window as any).showConfirm(
      'Eliminar categoría',
      n
        ? `"${cat.nombre}" tiene ${n} productos. Seguirán existiendo, pero sin esta categoría en el formulario.`
        : `Se eliminará "${cat.nombre}".`,
    );
    if (!ok) return;
    try {
      await deleteCategory(cat.id);
      categories = categories.filter((c) => c.id !== cat.id);
      render();
      showToast('Categoría eliminada', 'success');
    } catch (error) {
      console.error(error);
      showToast('No se pudo eliminar la categoría.', 'error');
    }
  });

  async function init() {
    await requireAdmin();
    const [cats, products]: any[] = await Promise.all([getCategories(), getProducts()]);
    categories = cats.sort((a: any, b: any) => String(a.nombre).localeCompare(String(b.nombre)));
    counts = products.reduce((acc: Record<string, number>, p: any) => {
      acc[p.categoria] = (acc[p.categoria] || 0) + 1;
      return acc;
    }, {});
    render();
  }
  init();
</script>
