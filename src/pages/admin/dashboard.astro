---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Resumen">
  <h1 class="text-3xl font-bold sm:text-4xl">Resumen</h1>
  <p id="greeting" class="mt-1 text-gris">&nbsp;</p>

  <!-- El número más importante va primero y más grande -->
  <div class="mt-6 grid gap-4 lg:grid-cols-[1.3fr_1fr]">
    <a href="/admin/orders?estado=pendiente" class="group relative overflow-hidden rounded-[24px] bg-ciruela p-6 text-white sm:p-8">
      <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-morado-vivo/40 blur-3xl"></div>
      <p class="relative text-white/70">Pedidos por atender</p>
      <p id="stat-pending" class="relative mt-2 font-display text-6xl font-extrabold text-oro-claro">—</p>
      <p class="relative mt-4 text-sm font-semibold text-white/80 group-hover:text-white">Ver pedidos pendientes</p>
    </a>
    <div class="grid grid-cols-2 gap-4">
      <div class="panel p-5">
        <p class="text-sm text-gris">Ingresos completados</p>
        <p id="stat-revenue" class="mt-1 font-display text-2xl font-bold text-morado sm:text-3xl">—</p>
      </div>
      <div class="panel p-5">
        <p class="text-sm text-gris">Pedidos en total</p>
        <p id="stat-orders" class="mt-1 font-display text-2xl font-bold sm:text-3xl">—</p>
      </div>
      <div class="panel p-5">
        <p class="text-sm text-gris">Productos activos</p>
        <p id="stat-products" class="mt-1 font-display text-2xl font-bold sm:text-3xl">—</p>
      </div>
      <div class="panel p-5">
        <p class="text-sm text-gris">Clientes</p>
        <p id="stat-users" class="mt-1 font-display text-2xl font-bold sm:text-3xl">—</p>
      </div>
    </div>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-[1.3fr_1fr]">
    <section class="panel">
      <div class="flex items-center justify-between border-b border-borde p-5">
        <h2 class="text-lg font-bold">Últimos pedidos</h2>
        <a href="/admin/orders" class="text-sm font-semibold text-morado hover:underline">Ver todos</a>
      </div>
      <ul id="recent-orders" class="divide-y divide-borde">
        <li class="p-5"><div class="skeleton h-10"></div></li>
        <li class="p-5"><div class="skeleton h-10"></div></li>
      </ul>
    </section>

    <section class="panel">
      <div class="flex items-center justify-between border-b border-borde p-5">
        <h2 class="text-lg font-bold">Poco stock</h2>
        <a href="/admin/products" class="text-sm font-semibold text-morado hover:underline">Ver productos</a>
      </div>
      <ul id="low-stock" class="divide-y divide-borde">
        <li class="p-5"><div class="skeleton h-10"></div></li>
      </ul>
    </section>
  </div>
</AdminLayout>

<script>
  import { requireAdmin } from '../../lib/adminGuard.js';
  import { getProducts } from '../../lib/firebaseProducts.js';
  import { getUsers } from '../../lib/firebaseUsers.js';
  import { getOrders } from '../../lib/firebaseOrders.js';
  import { escapeHtml, formatPrice, formatDate } from '../../lib/utils.js';

  const $ = (id: string) => document.getElementById(id) as HTMLElement;

  async function init() {
    const user: any = await requireAdmin();
    $('greeting').textContent = `Hola, ${(user?.nombre || '').split(' ')[0]}. Así va tu tienda.`;

    const [products, users, orders]: any[] = await Promise.all([getProducts(), getUsers(), getOrders()]);

    const estado = (o: any) => (o.estado || 'pendiente').toLowerCase();
    $('stat-pending').textContent = String(orders.filter((o: any) => estado(o) === 'pendiente').length);
    $('stat-orders').textContent = String(orders.length);
    $('stat-products').textContent = String(products.filter((p: any) => p.estado === 'activo').length);
    $('stat-users').textContent = String(users.filter((u: any) => u.rol !== 'admin').length);
    $('stat-revenue').textContent = formatPrice(
      orders.filter((o: any) => estado(o) === 'completado').reduce((s: number, o: any) => s + Number(o.total || 0), 0),
    );

    const recent = [...orders].sort((a, b) => (b.fecha?.seconds || 0) - (a.fecha?.seconds || 0)).slice(0, 5);
    $('recent-orders').innerHTML = recent.length
      ? recent
          .map(
            (o: any) => `
        <li class="flex items-center justify-between gap-4 p-5">
          <div class="min-w-0">
            <p class="truncate font-semibold">${escapeHtml(o.nombre || o.clienteNombre || 'Cliente')}</p>
            <p class="text-sm text-gris">${formatDate(o.fecha)}</p>
          </div>
          <div class="text-right">
            <p class="font-display font-bold">${formatPrice(o.total)}</p>
            <span class="badge badge-${estado(o)}">${escapeHtml(estado(o))}</span>
          </div>
        </li>`,
          )
          .join('')
      : '<li class="p-8 text-center text-gris">Todavía no hay pedidos.</li>';

    const low = products
      .filter((p: any) => Number(p.stock) <= 5)
      .sort((a: any, b: any) => Number(a.stock) - Number(b.stock))
      .slice(0, 6);
    $('low-stock').innerHTML = low.length
      ? low
          .map(
            (p: any) => `
        <li class="flex items-center justify-between gap-4 p-5">
          <p class="min-w-0 truncate font-medium">${escapeHtml(p.nombre)}</p>
          <span class="badge ${Number(p.stock) === 0 ? 'badge-cancelado' : 'badge-pendiente'}">${Number(p.stock) === 0 ? 'Agotado' : `${p.stock} unid.`}</span>
        </li>`,
          )
          .join('')
      : '<li class="p-8 text-center text-gris">Todos los productos tienen buen stock.</li>';
  }

  init();
</script>
