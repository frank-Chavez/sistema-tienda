---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Tu tienda naturista de confianza. Productos 100% naturales para tu bienestar.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Tienda Naturista</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="min-h-screen flex flex-col font-['Inter'] bg-gray-50 text-gray-800 antialiased selection:bg-purple-200"
  >
    <Navbar />

    <main class="grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  /* Base Tailwind directives are expected in global.css */

  [x-cloak] {
    display: none !important;
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #f1f1f1;
  }
  ::-webkit-scrollbar-thumb {
    background: #d8b4fe;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #a855f7;
  }
</style>
