---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BottomNav from '../components/BottomNav.astro';

interface Props {
  title: string;
  description?: string;
  /** Las páginas de administración no muestran pie ni barra inferior de tienda. */
  admin?: boolean;
}

const {
  title,
  description = 'Tienda naturista E.F.D. en Santa Rosa. Productos naturales con pedido directo por WhatsApp.',
  admin = false,
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#2a0e4f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | E.F.D. Tienda Naturista</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Instrument+Sans:wght@400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={`flex min-h-screen flex-col antialiased ${admin ? '' : 'pb-[calc(4.5rem+env(safe-area-inset-bottom))] md:pb-0'}`}>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:rounded-full focus:bg-white focus:px-4 focus:py-2">
      Ir al contenido
    </a>
    <Navbar admin={admin} />

    <main id="contenido" class="grow">
      <slot />
    </main>

    {!admin && <Footer />}
    {!admin && <BottomNav />}
  </body>
</html>
